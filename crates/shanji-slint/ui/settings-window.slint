import { Button, ScrollView, ListView, LineEdit, TextEdit, CheckBox, ComboBox } from "std-widgets.slint";
import { Icons } from "icons.slint";
import { CustomSelector } from "form.slint";

// ── 配色 Palette（浅色模式，in-out 支持将来深色模式切换）─────────────────
global Palette {
    in-out property <brush> sidebar-bg: #f0f1f3;
    in-out property <brush> content-bg: #f5f6f8;
    in-out property <brush> card-bg: #ffffff;
    in-out property <brush> border: #e0e2e6;
    in-out property <brush> text-primary: #111827;
    in-out property <brush> text-secondary: #6b7280;
    in-out property <brush> text-muted: #9ca3af;
    in-out property <brush> nav-active-bg: #e5e7eb;
    in-out property <brush> accent: #2563eb;
    in-out property <brush> danger: #dc2626;
    in-out property <brush> danger-bg: #fef2f2;
    in-out property <brush> danger-border: #fecaca;
}

// ── 页面枚举 ──────────────────────────────────────────────────────────────
export enum SettingsSection { Asr, Llm, Output, Hotkeys, Network, History, About }

// ── 历史卡片数据结构 ───────────────────────────────────────────────────────
export struct HistoryCardData {
    record-id: int,
    timestamp: string,
    text: string,
    has-audio: bool,
    is-playing: bool,
    is-retranscribing: bool,
    is-llm-rewritten: bool,
    was-pasted: bool,
}

// ── 热词库卡片数据结构 ─────────────────────────────────────────────────────
export struct HotwordLibraryCard {
    id: string,
    name: string,
    enabled: bool,
    word-count-text: string,
    is-builtin: bool,
    source-text: string,
    format-text: string,
}

// ── 可复用：侧边栏菜单项 ──────────────────────────────────────────────────
component NavItem inherits Rectangle {
    in property <string> label;
    in property <string> icon-path;
    in property <bool> active: false;
    callback clicked;

    height: 38px;
    border-radius: 7px;
    background: active ? Palette.nav-active-bg : transparent;

    ta := TouchArea {
        clicked => { root.clicked(); }
        mouse-cursor: pointer;
    }

    HorizontalLayout {
        padding-left: 12px;
        padding-right: 12px;
        alignment: start;
        spacing: 8px;

        // Icon (16×16, vertically centred in the 38px row)
        Rectangle {
            width: 16px;
            height: 38px;
            background: transparent;

            Path {
                x: 0;
                y: (parent.height - self.height) / 2;
                width: 16px;
                height: 16px;
                viewbox-width: 24;
                viewbox-height: 24;
                commands: root.icon-path;
                stroke: root.active ? Palette.text-primary : Palette.text-secondary;
                stroke-width: 1.8px;
                fill: transparent;
            }
        }

        Text {
            text: root.label;
            color: root.active ? Palette.text-primary : Palette.text-secondary;
            font-size: 14px;
            font-weight: root.active ? 600 : 400;
            vertical-alignment: center;
        }
    }
}

// ── 可复用：设置分组标题 ──────────────────────────────────────────────────
export component SectionLabel inherits Text {
    in property <string> label;
    text: root.label;
    color: Palette.text-secondary;
    font-size: 14px;
    font-weight: 700;
    letter-spacing: 0.4px;
}

// ── 可复用：开关控件 ───────────────────────────────────────────────────────
export component ToggleSwitch inherits Rectangle {
    in-out property <bool> checked: false;
    in property <bool> enabled: true;
    callback toggled(bool);

    width: 36px;
    height: 20px;
    border-radius: 10px;
    background: root.checked ? (root.enabled ? Palette.accent : #93c5fd) : #d1d5db;

    ta := TouchArea {
        enabled: root.enabled;
        clicked => {
            root.checked = !root.checked;
            root.toggled(root.checked);
        }
        mouse-cursor: pointer;
    }

    thumb := Rectangle {
        x: root.checked ? (parent.width - self.width - 2px) : 2px;
        y: 2px;
        width: 16px;
        height: 16px;
        border-radius: 10px;
        background: #ffffff;

        animate x { duration: 120ms; easing: ease-in-out; }
    }
}

// ── 设置页 ─────────────────────────────────────────────────────────────────
export component SettingsPage inherits Rectangle {
    // ── 导航状态 ──
    in-out property <SettingsSection> active-section: SettingsSection.Asr;
    in property <bool> show-back-button: false;

    // ── ASR 页属性 — 实时模型 ──
    in-out property <string> live-model-id: "paraformer-zh-streaming";
    in-out property <string> live-model-size-text: "约 220 MB";
    in-out property <bool>   live-model-downloaded: false;
    in-out property <bool>   live-model-downloading: false;
    in-out property <float>  live-model-download-progress: 0.0;
    in-out property <string> live-model-download-status-text: "";

    // ── ASR 页属性 — 离线纠正模型 ──
    in-out property <bool>   refine-asr-enabled: false;
    in-out property <string> refine-model-id: "paraformer-zh";
    in-out property <string> refine-model-size-text: "约 240 MB";
    in-out property <bool>   refine-model-downloaded: false;
    in-out property <bool>   refine-model-downloading: false;
    in-out property <float>  refine-model-download-progress: 0.0;
    in-out property <string> refine-model-download-status-text: "";

    // ── ASR 页属性 — 热词库 ──
    in property  <[HotwordLibraryCard]> hotword-libraries: [];
    in-out property <string> hotword-stats-text: "共 0 个词库";
    in-out property <string> hotword-dir-text: "";
    in-out property <string> hotword-hint-text: "";

    // ── ASR 页属性 — 音频 ──
    in property  <[string]>  audio-devices: [];
    in-out property <int>    audio-device-index: 0;
    in-out property <string> mic-test-status: "";

    // ── LLM 页属性 ──
    in-out property <bool>   llm-enabled: false;
    in-out property <string> llm-base-url: "https://api.openai.com/v1";
    in-out property <bool>   llm-api-key-saved: false;
    in-out property <string> llm-model-name: "gpt-4o-mini";
    in-out property <string> llm-system-prompt: "";
    in-out property <string> llm-active-prompt-id: "default";
    in-out property <string> llm-test-status-text: "";
    // 0=未测试/测试中  1=成功  2=失败
    in-out property <int>    llm-test-status-type: 0;
    in-out property <bool>   llm-testing: false;

    // ── Output 页属性 ──
    in-out property <string> punct-style-text: "zh";
    in-out property <string> append-content-text: "space";
    in-out property <bool>   overlay-visible: false;
    in-out property <string> theme-text: "system";

    // ── Hotkeys 页属性 ──
    in-out property <string> hotkey-summary-text: "未设置";

    // ── Network 页属性 ──
    in-out property <int>    github-proxy-index: 0;

    // ── History 页属性 ──
    in property  <[HistoryCardData]> history-records: [];
    in-out property <string> history-stats-text: "共 0 条";

    // ── About 页属性 ──
    in-out property <string> app-version-text: "v0.1";
    in-out property <string> config-path-text: "";

    // ── Callbacks ──
    // ASR — 模型
    callback toggle-refine-asr-requested();
    callback download-live-model-requested();
    callback download-refine-model-requested();
    // ASR — 热词库
    callback toggle-hotword-library-requested(string);
    callback open-hotword-dir-requested();
    // ASR — 音频
    callback select-audio-device-requested(int);
    callback test-mic-requested();
    // LLM
    callback toggle-rewrite-requested();
    callback set-active-prompt-requested(string);
    callback set-llm-base-url(string);
    callback set-llm-api-key(string);
    callback set-llm-model-name(string);
    callback set-llm-system-prompt(string);
    callback test-llm-api-requested();
    // Output
    callback cycle-punct-style-requested();
    callback cycle-append-content-requested();
    callback toggle-overlay-requested();
    callback cycle-theme-requested();
    // Hotkeys
    callback record-hotkey-requested();
    // Network
    callback cycle-github-proxy-requested();
    // History
    callback refresh-history-requested();
    callback clear-history-requested();
    callback play-audio-requested(int);
    callback retranscribe-requested(int);
    callback copy-record-requested(int);
    callback paste-record-requested(int);
    callback delete-record-requested(int);
    // About
    callback clear-session-requested();
    callback back-requested();

    defocus-scope := FocusScope { x: 0; y: 0; width: 0; height: 0; }

    Rectangle {
        width: parent.width;
        height: parent.height;
        background: Palette.content-bg;

        // 背景点击区域：点击任意空白处让输入框失焦
        TouchArea {
            x: 0; y: 0; width: parent.width; height: parent.height;
            mouse-cursor: default;
            clicked => { defocus-scope.focus(); }
        }

        HorizontalLayout {

            // ── 左侧边栏 ─────────────────────────────────────────────────
            Rectangle {
                width: 180px;
                background: Palette.sidebar-bg;
                border-width: 0px;

                // 右侧 1px 分割线
                Rectangle {
                    x: parent.width - 1px;
                    width: 1px;
                    height: parent.height;
                    background: Palette.border;
                }

                VerticalLayout {
                    padding: 0px;

                    // ── 头部（单一区域）──────────────────────────────────────
                    Rectangle {
                        height: 62px;

                        HorizontalLayout {
                            padding-left: 16px;
                            padding-right: 16px;
                            alignment: center;
                            spacing: 10px;

                            if root.show-back-button: Rectangle {
                                background: back-ta.has-hover ? Palette.nav-active-bg : transparent;
                                border-radius: 10px;
                                horizontal-stretch: 1;

                                back-ta := TouchArea {
                                    clicked => { root.back-requested(); }
                                    mouse-cursor: pointer;
                                }

                                HorizontalLayout {
                                    padding-left: 10px;
                                    padding-right: 10px;
                                    alignment: start;
                                    spacing: 8px;

                                    Rectangle {
                                        width: 20px; height: 62px;
                                        background: transparent;

                                        Path {
                                            x: 0;
                                            y: (parent.height - self.height) / 2;
                                            width: 20px; height: 20px;
                                            viewbox-width: 24; viewbox-height: 24;
                                            commands: Icons.house;
                                            stroke: Palette.text-primary;
                                            stroke-width: 2px;
                                            fill: transparent;
                                        }
                                    }

                                    Text {
                                        text: "返回主页";
                                        color: Palette.text-primary;
                                        font-size: 15px;
                                        font-weight: 700;
                                        vertical-alignment: center;
                                    }
                                }
                            }

                            if !root.show-back-button: VerticalLayout {
                                alignment: center;
                                spacing: 3px;
                                Text {
                                    text: "闪记";
                                    color: Palette.text-primary;
                                    font-size: 17px;
                                    font-weight: 800;
                                }
                                Text {
                                    text: root.app-version-text + " · 设置";
                                    color: Palette.text-muted;
                                    font-size: 12px;
                                }
                            }
                        }

                        // 底部分割线
                        Rectangle {
                            y: parent.height - 1px;
                            height: 1px;
                            background: Palette.border;
                        }
                    }

                    // 菜单项
                    Rectangle { height: 6px; }  // 顶部间距

                    HorizontalLayout {
                        height: 38px;
                        padding-left: 8px;
                        padding-right: 8px;
                        NavItem {
                            horizontal-stretch: 1;
                            icon-path: Icons.mic;
                            label: "语音识别";
                            active: root.active-section == SettingsSection.Asr;
                            clicked => { root.active-section = SettingsSection.Asr; }
                        }
                    }
                    HorizontalLayout {
                        height: 38px;
                        padding-left: 8px;
                        padding-right: 8px;
                        NavItem {
                            horizontal-stretch: 1;
                            icon-path: Icons.sparkles;
                            label: "LLM 润色";
                            active: root.active-section == SettingsSection.Llm;
                            clicked => { root.active-section = SettingsSection.Llm; }
                        }
                    }
                    HorizontalLayout {
                        height: 38px;
                        padding-left: 8px;
                        padding-right: 8px;
                        NavItem {
                            horizontal-stretch: 1;
                            icon-path: Icons.send;
                            label: "输出";
                            active: root.active-section == SettingsSection.Output;
                            clicked => { root.active-section = SettingsSection.Output; }
                        }
                    }
                    HorizontalLayout {
                        height: 38px;
                        padding-left: 8px;
                        padding-right: 8px;
                        NavItem {
                            horizontal-stretch: 1;
                            icon-path: Icons.keyboard;
                            label: "快捷键";
                            active: root.active-section == SettingsSection.Hotkeys;
                            clicked => { root.active-section = SettingsSection.Hotkeys; }
                        }
                    }
                    HorizontalLayout {
                        height: 38px;
                        padding-left: 8px;
                        padding-right: 8px;
                        NavItem {
                            horizontal-stretch: 1;
                            icon-path: Icons.globe;
                            label: "网络";
                            active: root.active-section == SettingsSection.Network;
                            clicked => { root.active-section = SettingsSection.Network; }
                        }
                    }
                    HorizontalLayout {
                        height: 38px;
                        padding-left: 8px;
                        padding-right: 8px;
                        NavItem {
                            horizontal-stretch: 1;
                            icon-path: Icons.clock;
                            label: "历史记录";
                            active: root.active-section == SettingsSection.History;
                            clicked => { root.active-section = SettingsSection.History; }
                        }
                    }

                    // 弹性空白
                    Rectangle { vertical-stretch: 1; }

                    // 关于（置底）
                    Rectangle {
                        height: 1px;
                        background: Palette.border;
                    }
                    HorizontalLayout {
                        height: 38px;
                        padding-left: 8px;
                        padding-right: 8px;
                        NavItem {
                            horizontal-stretch: 1;
                            icon-path: Icons.info;
                            label: "关于";
                            active: root.active-section == SettingsSection.About;
                            clicked => { root.active-section = SettingsSection.About; }
                        }
                    }
                    Rectangle { height: 8px; }
                }
            }

            // ── 右侧内容区 ─────────────────────────────────────────────
            Rectangle {
                horizontal-stretch: 1;
                background: Palette.content-bg;
                clip: true;

// ── 语音识别页 ──
if root.active-section == SettingsSection.Asr: ScrollView {
    width: 100%;
    height: 100%;
    VerticalLayout {
        padding: 24px;
        spacing: 20px;
        alignment: start;

        VerticalLayout {
            spacing: 4px;
            Text { text: "语音识别"; color: Palette.text-primary; font-size: 19px; font-weight: 700; }
            Text { text: "ASR 模型配置、热词库与音频输入"; color: Palette.text-muted; font-size: 13px; }
        }

        // ① 实时识别模型
        VerticalLayout {
            spacing: 6px;
            SectionLabel { label: "实时识别模型"; }
            Rectangle {
            border-radius: 10px;
            clip: true;
            background: Palette.card-bg;
            border-width: 1px;
            border-color: Palette.border;
            height: live-model-card.min-height;
            live-model-card := VerticalLayout {
                // 模型信息行
                Rectangle {
                    height: 62px;
                    HorizontalLayout {
                        padding-left: 16px; padding-right: 16px;
                        alignment: space-between;
                        VerticalLayout {
                            alignment: center; spacing: 3px;
                            Text { text: root.live-model-id; color: Palette.text-primary; font-size: 13px; font-weight: 400; }
                            Text { text: "边说边转录，流式推理，低延迟实时识别"; color: Palette.text-secondary; font-size: 12px; }
                        }
                        // 状态标签：包裹在透明容器里以实现垂直居中
                        if root.live-model-downloaded && !root.live-model-downloading: Rectangle {
                            width: 72px; background: transparent;
                            Rectangle {
                                width: 72px; height: 24px;
                                x: 0; y: (parent.height - self.height) / 2;
                                border-radius: 5px; background: #f0fdf4; border-width: 1px; border-color: #bbf7d0;
                                Text { text: "✓ 已加载"; color: #16a34a; font-size: 11px; horizontal-alignment: center; vertical-alignment: center; }
                            }
                        }
                        if root.live-model-downloading: Rectangle {
                            width: 64px; background: transparent;
                            Rectangle {
                                width: 64px; height: 24px;
                                x: 0; y: (parent.height - self.height) / 2;
                                border-radius: 5px; background: #eff6ff; border-width: 1px; border-color: #bfdbfe;
                                Text { text: "下载中…"; color: #2563eb; font-size: 11px; horizontal-alignment: center; vertical-alignment: center; }
                            }
                        }
                        if !root.live-model-downloaded && !root.live-model-downloading: Rectangle {
                            width: 56px; background: transparent;
                            Rectangle {
                                width: 56px; height: 24px;
                                x: 0; y: (parent.height - self.height) / 2;
                                border-radius: 5px; background: #fef2f2; border-width: 1px; border-color: #fecaca;
                                Text { text: "未下载"; color: Palette.danger; font-size: 11px; horizontal-alignment: center; vertical-alignment: center; }
                            }
                        }
                    }
                    Rectangle { y: parent.height - 1px; height: 1px; background: Palette.border; }
                }
                // 未下载：提示 + 下载按钮
                if !root.live-model-downloaded && !root.live-model-downloading: Rectangle {
                    height: 44px;
                    HorizontalLayout {
                        padding-left: 16px; padding-right: 16px;
                        alignment: space-between;
                        Text { text: root.live-model-size-text; color: Palette.text-muted; font-size: 12px; vertical-alignment: center; }
                        Button { text: "下载模型"; clicked => { root.download-live-model-requested(); } }
                    }
                }
                // 下载中：进度条
                if root.live-model-downloading: VerticalLayout {
                    padding-top: 12px; padding-bottom: 12px;
                    padding-left: 16px; padding-right: 16px;
                    spacing: 6px;
                    HorizontalLayout {
                        alignment: space-between;
                        Text { text: root.live-model-download-status-text; color: Palette.text-secondary; font-size: 12px; vertical-alignment: center; }
                    }
                    Rectangle {
                        height: 6px; border-radius: 3px; background: #e5e7eb;
                        Rectangle {
                            x: 0; y: 0; height: 6px; border-radius: 3px; background: Palette.accent;
                            width: parent.width * root.live-model-download-progress;
                        }
                    }
                }
                // 已下载：元数据 footer（无 border-radius，由外层 clip 处理圆角）
                if root.live-model-downloaded && !root.live-model-downloading: Rectangle {
                    height: 34px;
                    background: #fafafa;
                    HorizontalLayout {
                        padding-left: 16px; padding-right: 16px;
                        spacing: 20px;
                        Text { text: root.live-model-size-text; color: Palette.text-muted; font-size: 11px; vertical-alignment: center; }
                        Text { text: "语言：中文（普通话）"; color: Palette.text-muted; font-size: 11px; vertical-alignment: center; }
                        Text { text: "格式：ONNX"; color: Palette.text-muted; font-size: 11px; vertical-alignment: center; }
                    }
                }
            }
        }
        } // end ①

        // ② 离线纠正模型
        VerticalLayout {
            spacing: 6px;
            SectionLabel { label: "离线纠正模型"; }
            Rectangle {
            border-radius: 10px;
            clip: true;
            background: Palette.card-bg;
            border-width: 1px;
            border-color: Palette.border;
            height: refine-model-card.min-height;
            refine-model-card := VerticalLayout {
                // 开关行（带说明）
                Rectangle {
                    height: 72px;
                    HorizontalLayout {
                        padding-left: 16px; padding-right: 16px;
                        alignment: space-between;
                        VerticalLayout {
                            alignment: center; spacing: 3px;
                            Text { text: "录音结束后全文纠正"; color: Palette.text-primary; font-size: 13px; font-weight: 400; }
                            Text {
                                text: "录音停止后重新推理完整音频，修正流式识别的错误，提升准确率（约增加 1–3 秒等待）";
                                color: Palette.text-secondary; font-size: 11px; wrap: word-wrap;
                                horizontal-stretch: 1;
                            }
                        }
                        // ToggleSwitch 垂直居中
                        Rectangle {
                            width: 36px; background: transparent;
                            ToggleSwitch {
                                x: 0; y: (parent.height - self.height) / 2;
                                checked: root.refine-asr-enabled;
                                toggled(v) => { root.toggle-refine-asr-requested(); }
                            }
                        }
                    }
                    Rectangle { y: parent.height - 1px; height: 1px; background: Palette.border; }
                }
                // 模型信息行
                Rectangle {
                    height: 54px;
                    HorizontalLayout {
                        padding-left: 16px; padding-right: 16px;
                        alignment: space-between;
                        VerticalLayout {
                            alignment: center; spacing: 2px;
                            Text { text: root.refine-model-id; color: Palette.text-primary; font-size: 13px; font-weight: 400; }
                            Text { text: "整体推理模型，精度高于流式版本"; color: Palette.text-muted; font-size: 11px; }
                        }
                        // 状态标签：包裹在透明容器里以实现垂直居中
                        if root.refine-model-downloaded && !root.refine-model-downloading: Rectangle {
                            width: 72px; background: transparent;
                            Rectangle {
                                width: 72px; height: 24px;
                                x: 0; y: (parent.height - self.height) / 2;
                                border-radius: 5px; background: #f0fdf4; border-width: 1px; border-color: #bbf7d0;
                                Text { text: "✓ 已加载"; color: #16a34a; font-size: 11px; horizontal-alignment: center; vertical-alignment: center; }
                            }
                        }
                        if root.refine-model-downloading: Rectangle {
                            width: 64px; background: transparent;
                            Rectangle {
                                width: 64px; height: 24px;
                                x: 0; y: (parent.height - self.height) / 2;
                                border-radius: 5px; background: #eff6ff; border-width: 1px; border-color: #bfdbfe;
                                Text { text: "下载中…"; color: #2563eb; font-size: 11px; horizontal-alignment: center; vertical-alignment: center; }
                            }
                        }
                        if !root.refine-model-downloaded && !root.refine-model-downloading: Rectangle {
                            width: 56px; background: transparent;
                            Rectangle {
                                width: 56px; height: 24px;
                                x: 0; y: (parent.height - self.height) / 2;
                                border-radius: 5px; background: #fef2f2; border-width: 1px; border-color: #fecaca;
                                Text { text: "未下载"; color: Palette.danger; font-size: 11px; horizontal-alignment: center; vertical-alignment: center; }
                            }
                        }
                    }
                    Rectangle { y: parent.height - 1px; height: 1px; background: Palette.border; }
                }
                // 未下载：下载按钮
                if !root.refine-model-downloaded && !root.refine-model-downloading: Rectangle {
                    height: 44px;
                    HorizontalLayout {
                        padding-left: 16px; padding-right: 16px;
                        alignment: space-between;
                        Text { text: root.refine-model-size-text; color: Palette.text-muted; font-size: 12px; vertical-alignment: center; }
                        Button { text: "下载模型"; clicked => { root.download-refine-model-requested(); } }
                    }
                }
                // 下载中：进度条
                if root.refine-model-downloading: VerticalLayout {
                    padding-top: 12px; padding-bottom: 12px;
                    padding-left: 16px; padding-right: 16px;
                    spacing: 6px;
                    HorizontalLayout {
                        alignment: space-between;
                        Text { text: root.refine-model-download-status-text; color: Palette.text-secondary; font-size: 12px; vertical-alignment: center; }
                    }
                    Rectangle {
                        height: 6px; border-radius: 3px; background: #e5e7eb;
                        Rectangle {
                            x: 0; y: 0; height: 6px; border-radius: 3px; background: Palette.accent;
                            width: parent.width * root.refine-model-download-progress;
                        }
                    }
                }
            }
        }
        } // end ②

        // ③ 热词库
        VerticalLayout {
            spacing: 6px;
            SectionLabel { label: "热词库"; }
            Text {
                text: root.hotword-hint-text;
                color: Palette.text-muted;
                font-size: 11px;
                wrap: word-wrap;
            }
            Rectangle {
            border-radius: 10px;
            background: Palette.card-bg;
            border-width: 1px;
            border-color: Palette.border;
            height: hotword-card.min-height;
            hotword-card := VerticalLayout {
                // 统计头
                Rectangle {
                    min-height: 52px;
                    VerticalLayout {
                        padding-left: 16px; padding-right: 16px;
                        padding-top: 8px; padding-bottom: 8px;
                        spacing: 0px;
                        HorizontalLayout {
                            alignment: space-between;
                            VerticalLayout {
                                alignment: start; spacing: 2px;
                                Text { text: root.hotword-stats-text; color: Palette.text-primary; font-size: 13px; font-weight: 400; }
                                Text { text: root.hotword-dir-text; color: Palette.text-muted; font-size: 11px; }
                            }
                            Rectangle {
                                min-width: 88px;
                                min-height: 30px;
                                VerticalLayout {
                                    alignment: center;
                                    Button {
                                        text: "打开目录";
                                        clicked => { root.open-hotword-dir-requested(); }
                                    }
                                }
                            }
                        }
                    }
                    Rectangle { y: parent.height - 1px; height: 1px; background: Palette.border; }
                }
                // 词库列表
                for lib in root.hotword-libraries: Rectangle {
                    min-height: 50px;
                    HorizontalLayout {
                        padding-left: 16px; padding-right: 16px;
                        alignment: space-between;
                        Rectangle {
                            min-height: 50px;
                            VerticalLayout {
                                alignment: center;
                                VerticalLayout {
                                    alignment: start; spacing: 3px;
                                    Text { text: lib.name; color: lib.enabled ? Palette.text-primary : Palette.text-muted; font-size: 13px; font-weight: 400; }
                                    HorizontalLayout {
                                        spacing: 6px;
                                        Text { text: lib.word-count-text; color: Palette.text-muted; font-size: 11px; vertical-alignment: center; }
                                        Rectangle {
                                            border-radius: 3px;
                                            background: lib.is-builtin ? #eff6ff : #f0fdf4;
                                            height: 16px; width: 44px;
                                            Text {
                                                text: lib.is-builtin ? "内置" : "自定义";
                                                color: lib.is-builtin ? #3b82f6 : #16a34a;
                                                font-size: 10px; horizontal-alignment: center; vertical-alignment: center;
                                            }
                                        }
                                        Text {
                                            text: lib.format-text;
                                            color: Palette.text-muted;
                                            font-size: 11px;
                                            vertical-alignment: center;
                                        }
                                    }
                                }
                            }
                        }
                        Rectangle {
                            min-width: 36px;
                            min-height: 50px;
                            VerticalLayout {
                                alignment: center;
                                ToggleSwitch {
                                    checked: lib.enabled;
                                    toggled(v) => { root.toggle-hotword-library-requested(lib.id); }
                                }
                            }
                        }
                    }
                    Rectangle { y: parent.height - 1px; height: 1px; background: Palette.border; opacity: 0.4; }
                }
            }
        }
        } // end ③

        // ④ 音频输入
        VerticalLayout {
            spacing: 6px;
            SectionLabel { label: "音频输入"; }
            Rectangle {
            border-radius: 10px;
            background: Palette.card-bg;
            border-width: 1px;
            border-color: Palette.border;
            VerticalLayout {
                Rectangle {
                    height: 54px;
                    HorizontalLayout {
                        padding-left: 16px; padding-right: 16px;
                        alignment: space-between;
                        VerticalLayout {
                            alignment: center; spacing: 2px;
                            Text { text: "输入设备"; color: Palette.text-primary; font-size: 13px; font-weight: 400; }
                            Text { text: "选择用于语音输入的麦克风设备"; color: Palette.text-muted; font-size: 11px; }
                        }
                        Rectangle {
                            min-width: 160px;
                            min-height: 30px;
                            VerticalLayout {
                                alignment: center;
                                CustomSelector {
                                    model: root.audio-devices;
                                    current-index: root.audio-device-index;
                                    selected(index) => {
                                        root.select-audio-device-requested(index);
                                    }
                                }
                            }
                        }
                    }
                    Rectangle { y: parent.height - 1px; height: 1px; background: Palette.border; }
                }
                Rectangle {
                    height: 44px;
                    HorizontalLayout {
                        padding-left: 16px; padding-right: 16px;
                        alignment: space-between;
                        Text {
                            text: root.mic-test-status == "" ? "测试麦克风是否正常工作" : root.mic-test-status;
                            color: Palette.text-primary;
                            font-size: 12px; vertical-alignment: center;
                        }
                        Rectangle {
                            min-width: 88px;
                            min-height: 30px;
                            VerticalLayout {
                                alignment: center;
                                Button { text: "测试麦克风"; clicked => { root.test-mic-requested(); } }
                            }
                        }
                    }
                }
            }
        }
        } // end ④
    }
}

// ── LLM 润色页 ──
if root.active-section == SettingsSection.Llm: ScrollView {
    width: 100%;
    height: 100%;
    VerticalLayout {
        padding: 24px;
        spacing: 20px;
        alignment: start;

        // 页面标题
        VerticalLayout {
            spacing: 4px;
            Text { text: "LLM 润色"; color: Palette.text-primary; font-size: 19px; font-weight: 700; }
            Text { text: "通过大模型对转录文本进行改写"; color: Palette.text-muted; font-size: 13px; }
        }

        // ① 功能开关
        VerticalLayout {
            spacing: 6px;
            SectionLabel { label: "功能开关"; }
            Rectangle {
                border-radius: 10px;
                clip: true;
                background: Palette.card-bg;
                border-width: 1px;
                border-color: Palette.border;
                height: 62px;
                HorizontalLayout {
                    padding-left: 16px; padding-right: 16px;
                    alignment: space-between;
                    VerticalLayout {
                        alignment: center; spacing: 3px;
                        Text { text: "启用 LLM 润色"; color: Palette.text-primary; font-size: 13px; font-weight: 400; }
                        Text { text: "关闭时直接输出 ASR 原始结果"; color: Palette.text-muted; font-size: 12px; }
                    }
                    Rectangle {
                        width: 36px; background: transparent;
                        ToggleSwitch {
                            x: 0; y: (parent.height - self.height) / 2;
                            checked: root.llm-enabled;
                            toggled(v) => { root.toggle-rewrite-requested(); defocus-scope.focus(); }
                        }
                    }
                }
            }
        }

        // ② API 配置
        VerticalLayout {
            spacing: 6px;
            SectionLabel { label: "API 配置"; }
            Rectangle {
                border-radius: 10px;
                clip: true;
                background: Palette.card-bg;
                border-width: 1px;
                border-color: Palette.border;
                height: api-card.min-height;
                api-card := VerticalLayout {
                    // API Base URL 行
                    Rectangle {
                        height: 54px;
                        HorizontalLayout {
                            padding-left: 16px; padding-right: 16px; spacing: 12px;
                            Text {
                                text: "API Base URL";
                                width: 90px;
                                color: root.llm-enabled ? Palette.text-primary : Palette.text-muted;
                                font-size: 13px; vertical-alignment: center;
                            }
                            Rectangle {
                                horizontal-stretch: 1; background: transparent;
                                LineEdit {
                                    width: parent.width;
                                    y: (parent.height - self.height) / 2;
                                    text: root.llm-base-url;
                                    enabled: root.llm-enabled;
                                    edited(v) => { root.set-llm-base-url(v); }
                                }
                            }
                        }
                        Rectangle { y: parent.height - 1px; height: 1px; background: Palette.border; }
                    }
                    // API Key 行
                    Rectangle {
                        height: 54px;
                        HorizontalLayout {
                            padding-left: 16px; padding-right: 16px; spacing: 12px;
                            Rectangle {
                                width: 90px; background: transparent;
                                VerticalLayout {
                                    alignment: center; spacing: 2px;
                                    Text { text: "API Key"; color: root.llm-enabled ? Palette.text-primary : Palette.text-muted; font-size: 13px; }
                                    Text { text: "本地加密存储"; color: Palette.text-muted; font-size: 11px; }
                                }
                            }
                            Rectangle {
                                horizontal-stretch: 1; background: transparent;
                                LineEdit {
                                    width: parent.width;
                                    y: (parent.height - self.height) / 2;
                                    input-type: InputType.password;
                                    placeholder-text: root.llm-api-key-saved ? "••••••••••••••••••• (已保存，输入新值覆盖)" : "sk-...";
                                    enabled: root.llm-enabled;
                                    edited(v) => {
                                        if v != "" { root.set-llm-api-key(v); }
                                    }
                                }
                            }
                        }
                        Rectangle { y: parent.height - 1px; height: 1px; background: Palette.border; }
                    }
                    // 模型名称行
                    Rectangle {
                        height: 54px;
                        HorizontalLayout {
                            padding-left: 16px; padding-right: 16px; spacing: 12px;
                            Text {
                                text: "模型名称";
                                width: 90px;
                                color: root.llm-enabled ? Palette.text-primary : Palette.text-muted;
                                font-size: 13px; vertical-alignment: center;
                            }
                            Rectangle {
                                horizontal-stretch: 1; background: transparent;
                                LineEdit {
                                    width: parent.width;
                                    y: (parent.height - self.height) / 2;
                                    text: root.llm-model-name;
                                    enabled: root.llm-enabled;
                                    edited(v) => { root.set-llm-model-name(v); }
                                }
                            }
                        }
                        Rectangle { y: parent.height - 1px; height: 1px; background: Palette.border; }
                    }
                    // 测试连接行
                    Rectangle {
                        height: 46px;
                        background: #fafafa;
                        HorizontalLayout {
                            padding-left: 16px; padding-right: 16px;
                            alignment: space-between;
                            Text {
                                text: root.llm-test-status-text == "" ? "尚未测试" : root.llm-test-status-text;
                                color: root.llm-test-status-type == 1 ? #22c55e
                                     : root.llm-test-status-type == 2 ? #ef4444
                                     : Palette.text-muted;
                                font-size: 12px; vertical-alignment: center;
                            }
                            Rectangle {
                                min-width: 88px; min-height: 30px;
                                VerticalLayout {
                                    alignment: center;
                                    Button {
                                        text: root.llm-testing ? "测试中…" : "测试连接";
                                        enabled: root.llm-enabled && !root.llm-testing;
                                        clicked => { root.test-llm-api-requested(); defocus-scope.focus(); }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }

        // ③ 润色风格
        VerticalLayout {
            spacing: 6px;
            SectionLabel { label: "润色风格"; }
            Rectangle {
                border-radius: 10px;
                clip: true;
                background: Palette.card-bg;
                border-width: 1px;
                border-color: Palette.border;
                height: settings-style-card.min-height;
                settings-style-card := VerticalLayout {
                    padding: 12px;
                    spacing: 8px;

                    Text {
                        text: "选择预设风格，或切换到【自定义】后在下方编辑提示词";
                        color: root.llm-enabled ? Palette.text-muted : Palette.text-muted;
                        font-size: 11px;
                        wrap: word-wrap;
                    }

                    HorizontalLayout {
                        spacing: 8px;
                        alignment: start;

                        for style-chip in [
                            {id: "default", label: "结构化",  desc: "归纳总结，善用编号条目"},
                            {id: "light",   label: "轻度整理", desc: "最少干预，忠实保留原意"},
                            {id: "formal",  label: "书面化",  desc: "适合邮件/文档"}
                        ]: Rectangle {
                            property <bool> chip-active: root.llm-active-prompt-id == style-chip.id;
                            border-radius: 8px;
                            background: chip-active ? #ede9fe : (root.llm-enabled ? Palette.content-bg : #f9fafb);
                            border-width: 1px;
                            border-color: chip-active ? #c4b5fd : Palette.border;
                            min-width: 80px;

                            style-chip-ta := TouchArea {
                                enabled: root.llm-enabled;
                                clicked => { root.set-active-prompt-requested(style-chip.id); }
                            }

                            VerticalLayout {
                                padding: 8px;
                                spacing: 2px;
                                Text {
                                    text: style-chip.label;
                                    color: chip-active ? #6d28d9 : (root.llm-enabled ? Palette.text-primary : Palette.text-muted);
                                    font-size: 12px;
                                    font-weight: chip-active ? 700 : 400;
                                    horizontal-alignment: center;
                                }
                                Text {
                                    text: style-chip.desc;
                                    color: chip-active ? #7c3aed : Palette.text-muted;
                                    font-size: 10px;
                                    horizontal-alignment: center;
                                }
                            }
                        }

                        // 自定义 chip
                        Rectangle {
                            property <bool> custom-active: root.llm-active-prompt-id == "custom";
                            border-radius: 8px;
                            background: custom-active ? #ede9fe : (root.llm-enabled ? Palette.content-bg : #f9fafb);
                            border-width: 1px;
                            border-color: custom-active ? #c4b5fd : Palette.border;
                            min-width: 80px;

                            custom-style-ta := TouchArea {
                                enabled: root.llm-enabled;
                                clicked => { root.set-active-prompt-requested("custom"); }
                            }

                            VerticalLayout {
                                padding: 8px;
                                spacing: 2px;
                                Text {
                                    text: "自定义";
                                    color: custom-active ? #6d28d9 : (root.llm-enabled ? Palette.text-primary : Palette.text-muted);
                                    font-size: 12px;
                                    font-weight: custom-active ? 700 : 400;
                                    horizontal-alignment: center;
                                }
                                Text {
                                    text: "编辑下方提示词";
                                    color: custom-active ? #7c3aed : Palette.text-muted;
                                    font-size: 10px;
                                    horizontal-alignment: center;
                                }
                            }
                        }
                    }
                }
            }
        }

        // ④ 润色提示词
        VerticalLayout {
            spacing: 6px;
            SectionLabel { label: "润色提示词（当前风格）"; }
            Rectangle {
                border-radius: 10px;
                clip: true;
                background: Palette.card-bg;
                border-width: 1px;
                border-color: Palette.border;
                height: 140px;
                TextEdit {
                    width: 100%;
                    height: 100%;
                    text: root.llm-system-prompt;
                    enabled: root.llm-enabled;
                    edited(v) => { root.set-llm-system-prompt(v); }
                }
            }
        }
    }
}

// ── 输出页 ──
if root.active-section == SettingsSection.Output: ScrollView {
    width: 100%;
    height: 100%;
    VerticalLayout {
        padding: 24px;
        spacing: 20px;
        alignment: start;

        VerticalLayout {
            spacing: 4px;
            Text { text: "输出"; color: Palette.text-primary; font-size: 19px; font-weight: 700; }
            Text { text: "文本格式与粘贴行为"; color: Palette.text-muted; font-size: 13px; }
        }

        SectionLabel { label: "格式"; }
        Rectangle {
            border-radius: 10px;
            background: Palette.card-bg;
            border-width: 1px;
            border-color: Palette.border;
            VerticalLayout {
                Rectangle {
                    height: 44px;
                    HorizontalLayout {
                        padding-left: 16px; padding-right: 16px;
                        alignment: space-between;
                        Text { text: "标点风格"; color: Palette.text-primary; font-size: 13px; font-weight: 400; vertical-alignment: center; }
                        Button { text: root.punct-style-text; clicked => { root.cycle-punct-style-requested(); } }
                    }
                    Rectangle { y: parent.height - 1px; height: 1px; background: Palette.border; }
                }
                Rectangle {
                    height: 44px;
                    HorizontalLayout {
                        padding-left: 16px; padding-right: 16px;
                        alignment: space-between;
                        Text { text: "追加内容"; color: Palette.text-primary; font-size: 13px; font-weight: 400; vertical-alignment: center; }
                        Button { text: root.append-content-text; clicked => { root.cycle-append-content-requested(); } }
                    }
                }
            }
        }

        SectionLabel { label: "界面"; }
        Rectangle {
            border-radius: 10px;
            background: Palette.card-bg;
            border-width: 1px;
            border-color: Palette.border;
            height: 44px;
            HorizontalLayout {
                padding-left: 16px; padding-right: 16px;
                alignment: space-between;
                Text { text: "悬浮窗"; color: Palette.text-primary; font-size: 13px; font-weight: 400; vertical-alignment: center; }
                ToggleSwitch {
                    checked: root.overlay-visible;
                    toggled(v) => { root.toggle-overlay-requested(); }
                }
            }
        }

        SectionLabel { label: "外观"; }
        Rectangle {
            border-radius: 10px;
            background: Palette.card-bg;
            border-width: 1px;
            border-color: Palette.border;
            height: 44px;
            HorizontalLayout {
                padding-left: 16px; padding-right: 16px;
                alignment: space-between;
                Text { text: "主题"; color: Palette.text-primary; font-size: 13px; font-weight: 400; vertical-alignment: center; }
                Button { text: root.theme-text; clicked => { root.cycle-theme-requested(); } }
            }
        }
    }
}

// ── 快捷键页 ──
if root.active-section == SettingsSection.Hotkeys: ScrollView {
    width: 100%;
    height: 100%;
    VerticalLayout {
        padding: 24px;
        spacing: 20px;
        alignment: start;

        VerticalLayout {
            spacing: 4px;
            Text { text: "快捷键"; color: Palette.text-primary; font-size: 19px; font-weight: 700; }
            Text { text: "全局快捷键设置"; color: Palette.text-muted; font-size: 13px; }
        }

        SectionLabel { label: "PUSH-TO-TALK"; }
        Rectangle {
            border-radius: 10px;
            background: Palette.card-bg;
            border-width: 1px;
            border-color: Palette.border;
            height: 54px;
            HorizontalLayout {
                padding-left: 16px; padding-right: 16px;
                alignment: space-between;
                VerticalLayout {
                    alignment: center; spacing: 2px;
                    Text { text: "当前快捷键"; color: Palette.text-primary; font-size: 13px; font-weight: 400; }
                    Text { text: root.hotkey-summary-text; color: Palette.text-muted; font-size: 12px; }
                }
                Button { text: "重新录制"; clicked => { root.record-hotkey-requested(); } }
            }
        }
    }
}

// ── 网络页 ──
if root.active-section == SettingsSection.Network: ScrollView {
    width: 100%;
    height: 100%;
    VerticalLayout {
        padding: 24px;
        spacing: 20px;
        alignment: start;

        VerticalLayout {
            spacing: 4px;
            Text { text: "网络"; color: Palette.text-primary; font-size: 19px; font-weight: 700; }
            Text { text: "模型下载代理配置"; color: Palette.text-muted; font-size: 13px; }
        }

        SectionLabel { label: "下载代理"; }
        Rectangle {
            border-radius: 10px;
            background: Palette.card-bg;
            border-width: 1px;
            border-color: Palette.border;
            height: 44px;
            HorizontalLayout {
                padding-left: 16px; padding-right: 16px;
                alignment: space-between;
                Text { text: "GitHub 代理"; color: Palette.text-primary; font-size: 13px; font-weight: 400; vertical-alignment: center; }
                Button { text: "切换"; clicked => { root.cycle-github-proxy-requested(); } }
            }
        }
    }
}

// ── 历史记录页 ──
if root.active-section == SettingsSection.History: Rectangle {
    width: 100%;
    height: 100%;
    VerticalLayout {
        // 顶部操作栏（固定）
        Rectangle {
            height: 52px;
            HorizontalLayout {
                padding-left: 20px; padding-right: 20px;
                alignment: space-between;
                VerticalLayout {
                    alignment: center;
                    spacing: 2px;
                    Text { text: "历史记录"; color: Palette.text-primary; font-size: 19px; font-weight: 700; }
                    Text { text: root.history-stats-text; color: Palette.text-muted; font-size: 13px; }
                }
                HorizontalLayout {
                    alignment: end;
                    spacing: 8px;
                    Button { text: "刷新"; clicked => { root.refresh-history-requested(); } }
                    Button { text: "清空全部"; clicked => { root.clear-history-requested(); } }
                }
            }
            Rectangle { y: parent.height - 1px; height: 1px; background: Palette.border; }
        }

        // 卡片列表（可滚动）
        history-list := ListView {
            vertical-stretch: 1;

            for card in root.history-records: Rectangle {
                width: history-list.width;
                height: 110px;
                background: transparent;

                Rectangle {
                    x: 16px;
                    y: 0;
                    width: max(0px, parent.width - 32px);
                    height: 100px;
                    border-radius: 10px;
                    background: Palette.card-bg;
                    border-width: 1px;
                    border-color: Palette.border;
                    clip: true;
                    cache-rendering-hint: true;

                    VerticalLayout {
                        padding-top: 12px;
                        padding-bottom: 10px;
                        padding-left: 16px;
                        padding-right: 16px;
                        spacing: 6px;

                        HorizontalLayout {
                            alignment: space-between;
                            Text {
                                text: card.timestamp;
                                color: Palette.text-muted;
                                font-size: 12px;
                                vertical-alignment: center;
                            }
                            HorizontalLayout {
                                spacing: 4px;
                                if card.has-audio: Button {
                                    text: card.is-playing ? "■ 停止" : "▶ 播放";
                                    clicked => { root.play-audio-requested(card.record-id); }
                                }
                                if card.has-audio: Button {
                                    enabled: !card.is-retranscribing;
                                    text: card.is-retranscribing ? "转写中..." : "↻ 重新转录";
                                    clicked => { root.retranscribe-requested(card.record-id); }
                                }
                                Button { text: "复制"; clicked => { root.copy-record-requested(card.record-id); } }
                                Button { text: "粘贴"; clicked => { root.paste-record-requested(card.record-id); } }
                                Button { text: "删除"; clicked => { root.delete-record-requested(card.record-id); } }
                            }
                        }

                        // overflow: elide 单行省略，消除 word-wrap 折行测量开销
                        Text {
                            text: card.text;
                            color: Palette.text-primary;
                            font-size: 12px;
                            overflow: elide;
                            vertical-stretch: 1;
                        }

                        HorizontalLayout {
                            spacing: 6px;
                            if card.is-llm-rewritten: Rectangle {
                                border-radius: 3px;
                                background: #eff6ff;
                                height: 16px;
                                width: 56px;
                                Text { text: "LLM润色"; color: #3b82f6; font-size: 10px; horizontal-alignment: center; vertical-alignment: center; }
                            }
                            if !card.is-llm-rewritten: Rectangle {
                                border-radius: 3px;
                                background: #f3f4f6;
                                height: 16px;
                                width: 56px;
                                Text { text: "原始转录"; color: Palette.text-muted; font-size: 10px; horizontal-alignment: center; vertical-alignment: center; }
                            }
                            if card.has-audio: Rectangle {
                                border-radius: 3px;
                                background: Palette.card-bg;
                                border-width: 1px;
                                border-color: Palette.border;
                                height: 16px;
                                width: 56px;
                                Text { text: "🎙 有录音"; color: Palette.text-muted; font-size: 10px; horizontal-alignment: center; vertical-alignment: center; }
                            }
                        }
                    }
                }
            }
        }
    }
}

// ── 关于页 ──
if root.active-section == SettingsSection.About: ScrollView {
    width: 100%;
    height: 100%;
    VerticalLayout {
        padding: 24px;
        spacing: 20px;
        alignment: start;

        VerticalLayout {
            spacing: 4px;
            Text { text: "关于"; color: Palette.text-primary; font-size: 19px; font-weight: 700; }
            Text { text: "闪记 · 本地 AI 语音输入"; color: Palette.text-muted; font-size: 13px; }
        }

        Rectangle {
            border-radius: 10px;
            background: Palette.card-bg;
            border-width: 1px;
            border-color: Palette.border;
            VerticalLayout {
                Rectangle {
                    height: 44px;
                    HorizontalLayout {
                        padding-left: 16px; padding-right: 16px;
                        alignment: space-between;
                        Text { text: "版本"; color: Palette.text-primary; font-size: 13px; font-weight: 400; vertical-alignment: center; }
                        Text { text: root.app-version-text; color: Palette.text-muted; font-size: 12px; vertical-alignment: center; }
                    }
                    Rectangle { y: parent.height - 1px; height: 1px; background: Palette.border; }
                }
                Rectangle {
                    height: 54px;
                    HorizontalLayout {
                        padding-left: 16px; padding-right: 16px;
                        alignment: space-between;
                        VerticalLayout {
                            alignment: center; spacing: 2px;
                            Text { text: "配置路径"; color: Palette.text-primary; font-size: 13px; font-weight: 400; }
                            Text { text: root.config-path-text; color: Palette.text-muted; font-size: 10px; wrap: word-wrap; }
                        }
                    }
                }
            }
        }

        Rectangle {
            border-radius: 10px;
            background: Palette.danger-bg;
            border-width: 1px;
            border-color: Palette.danger-border;
            height: 44px;
            HorizontalLayout {
                padding-left: 16px; padding-right: 16px;
                alignment: space-between;
                Text { text: "清理会话"; color: Palette.danger; font-size: 13px; font-weight: 400; vertical-alignment: center; }
                Button { text: "清理"; clicked => { root.clear-session-requested(); } }
            }
        }
    }
}

            }
        }
    }
}
