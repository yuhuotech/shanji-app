// ── Icon Library ─────────────────────────────────────────────────────────────
// Lucide icon paths (MIT license) — https://lucide.dev
// All paths use a 24×24 viewbox.

export global Icons {
    // ── Home page section header icons ───────────────────────────────────────

    // Zap (lightning bolt) — real-time streaming model
    out property <string> zap: "M 13 2 L 3 14 L 12 14 L 11 22 L 21 10 L 12 10 Z";

    // Layers (stacked) — offline/refine model
    out property <string> layers: "M 12 2 L 2 7 L 12 12 L 22 7 Z M 2 17 L 12 22 L 22 17 M 2 12 L 12 17 L 22 12";

    // Mic — microphone / audio input
    out property <string> mic: "M 12 2 A 3 3 0 0 1 15 5 L 15 12 A 3 3 0 0 1 9 12 L 9 5 A 3 3 0 0 1 12 2 Z M 19 10 L 19 12 A 7 7 0 0 1 5 12 L 5 10 M 12 19 L 12 22 M 9 22 L 15 22";

    // Shield check — local offline / privacy
    out property <string> shield-check: "M 12 22 C 7 20 3 17 3 12 L 3 5 L 12 2 L 21 5 L 21 12 C 21 17 17 20 12 22 Z M 9 12 L 11 14 L 15 10";

    // Send (paper airplane) — auto paste / output
    out property <string> send: "M 22 2 L 11 13 M 22 2 L 15 22 L 11 13 L 2 9 Z";

    // Sparkles (4-point star + small stars) — LLM rewrite / AI
    out property <string> sparkles: "M 12 3 L 14 9 L 20 12 L 14 15 L 12 21 L 10 15 L 4 12 L 10 9 Z M 5 3 L 5.5 4.5 L 7 5 L 5.5 5.5 L 5 7 L 4.5 5.5 L 3 5 L 4.5 4.5 Z M 19 13 L 19.5 14.5 L 21 15 L 19.5 15.5 L 19 17 L 18.5 15.5 L 17 15 L 18.5 14.5 Z";

    // Pen (diagonal) — edit / rewrite
    out property <string> pen: "M 17 3 A 2.83 2.83 0 0 1 21 7 L 7 21 L 3 21 L 3 17 Z M 15 5 L 19 9";

    // House — home / back to main
    out property <string> house: "M 3 9 L 12 2 L 21 9 L 21 20 A 1 1 0 0 1 20 21 L 4 21 A 1 1 0 0 1 3 20 Z M 9 21 L 9 15 L 15 15 L 15 21";

    // Arrow left — back
    out property <string> arrow-left: "M 19 12 L 5 12 M 12 19 L 5 12 L 12 5";

    // ── Toolbar icon buttons ─────────────────────────────────────────────────

    // Refresh (circular arrows)
    out property <string> refresh: "M 23 4 L 23 10 L 17 10 M 1 20 L 1 14 L 7 14 M 3.51 9 A 9 9 0 0 1 18.36 5.64 L 23 10 M 1 14 L 5.64 18.36 A 9 9 0 0 0 20.49 15";

    // Clock — history / time
    out property <string> clock: "M 12 2 A 10 10 0 1 0 12 22 A 10 10 0 0 0 12 2 Z M 12 6 L 12 12 L 16 14";

    // Sliders — settings / configuration
    out property <string> sliders: "M 4 21 L 4 14 M 4 10 L 4 3 M 12 21 L 12 12 M 12 8 L 12 3 M 20 21 L 20 16 M 20 12 L 20 3 M 1 14 L 7 14 M 9 8 L 15 8 M 17 16 L 23 16";

    // ── Settings sidebar nav icons ───────────────────────────────────────────

    // Globe — network / internet
    out property <string> globe: "M 12 2 A 10 10 0 1 0 12 22 A 10 10 0 0 0 12 2 Z M 2 12 L 22 12 M 12 2 A 15.3 15.3 0 0 1 16 12 A 15.3 15.3 0 0 1 12 22 A 15.3 15.3 0 0 1 8 12 A 15.3 15.3 0 0 1 12 2 Z";

    // Info circle — about
    out property <string> info: "M 12 2 A 10 10 0 1 0 12 22 A 10 10 0 0 0 12 2 Z M 12 8 L 12 9 M 12 11 L 12 16";

    // Keyboard — hotkeys / shortcuts
    out property <string> keyboard: "M 3 5 L 21 5 L 21 19 L 3 19 Z M 7 9 L 9 9 M 11 9 L 13 9 M 15 9 L 17 9 M 7 13 L 9 13 M 11 13 L 13 13 M 15 13 L 17 13 M 7 17 L 17 17";
}

// ── SvgIcon: coloured background box with a white SVG icon ──────────────────
// Drop-in replacement for the old text-character SectionIcon.
export component SvgIcon inherits Rectangle {
    in property <string> commands;
    in property <brush> icon-color;

    width: 22px;
    height: 22px;
    border-radius: 6px;
    background: icon-color;

    Path {
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        width: 14px;
        height: 14px;
        viewbox-width: 24;
        viewbox-height: 24;
        commands: root.commands;
        stroke: #ffffff;
        stroke-width: 2px;
        fill: transparent;
    }
}
