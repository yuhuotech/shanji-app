                                    background: #2962ff;

                                    Text {
                                        text: "🎤";
                                        color: #ffffff;
                                        horizontal-alignment: center;
                                        vertical-alignment: center;
                                        font-size: 24px;
                                    }
                                }

                                VerticalLayout {
                                    spacing: 4px;
                                    Text { text: transcribe-button-text; color: #1f2937; font-size: 18px; font-weight: 700; }
                                    Text { text: transcribe-body-text; color: #667085; wrap: word-wrap; font-size: 14px; }
                                }
                            }

