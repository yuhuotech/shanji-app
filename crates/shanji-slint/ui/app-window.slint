                            }

                            Button {
                                text: transcribe-button-text;
                                primary: true;
                                clicked => { root.toggle-live-asr-requested(); }
                            }

                            Rectangle {
                                border-radius: 14px;
                                background: #fff7e8;

                                VerticalLayout {
                                    padding: 14px;

                                    Text {
                                        text: monitor-tip-text;
                                        color: #c26b16;
                                        wrap: word-wrap;
                                        font-size: 14px;
                                        font-weight: 600;
                                    }
                                }
                            }
                        }
                        }
                    }

                    if root.compact-layout : VerticalLayout {
                        spacing: 16px;

                        Rectangle {
