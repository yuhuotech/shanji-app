                                        Text { text: model-version-text; color: #1f2937; font-size: 16px; font-weight: 700; horizontal-alignment: center; }
                                    }
                                }

                                Rectangle {
                                    border-radius: 12px;
                                    background: #f2f4f7;
                                    horizontal-stretch: 1;
                                    VerticalLayout {
                                        padding: 12px;
                                        spacing: 4px;
                                        Text { text: "大小"; color: #667085; font-size: 13px; horizontal-alignment: center; }
                                        Text { text: model-size-text; color: #1f2937; font-size: 16px; font-weight: 700; horizontal-alignment: center; }
                                    }
                                }

                                Rectangle {
                                    border-radius: 12px;
                                    background: #f2f4f7;
                                    horizontal-stretch: 1;
                                    VerticalLayout {
                                        padding: 12px;
                                        spacing: 4px;
                                        Text { text: "语言"; color: #667085; font-size: 13px; horizontal-alignment: center; }
                                        Text { text: model-language-text; color: #1f2937; font-size: 16px; font-weight: 700; horizontal-alignment: center; }
                                    }
                                }
                            }

                            if root.narrow-layout : VerticalLayout {
                                spacing: 10px;

                                Rectangle {
                                    border-radius: 12px;
                                    background: #f2f4f7;
                                    VerticalLayout {
                                        padding: 12px;
                                        spacing: 4px;
                                        Text { text: "版本"; color: #667085; font-size: 13px; horizontal-alignment: center; }
                                        Text { text: model-version-text; color: #1f2937; font-size: 16px; font-weight: 700; horizontal-alignment: center; }
