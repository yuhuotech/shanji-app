import { Button, ScrollView } from "std-widgets.slint";
import { SettingsPage, SettingsSection, HotwordLibraryCard, HistoryCardData, ConfirmDialog } from "settings-window.slint";
import { Icons, SvgIcon } from "icons.slint";
import { CustomSelector } from "form.slint";

// ── Reusable: ghost icon button (SVG path) ───────────────────────────────────
component GhostIconButton inherits Rectangle {
    in property <string> icon-path;
    callback clicked;

    width: 34px;
    height: 30px;
    border-radius: 8px;
    border-width: 1px;
    border-color: #d0d8e4;
    background: ta.has-hover ? #f0f4f8 : #ffffff;

    ta := TouchArea { clicked => { root.clicked(); } }

    Path {
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        width: 16px;
        height: 16px;
        viewbox-width: 24;
        viewbox-height: 24;
        commands: root.icon-path;
        stroke: #4b5563;
        stroke-width: 1.8px;
        fill: transparent;
    }
}

// ── Reusable: info pill (版本 / 大小 / 语言) ─────────────────────────────────
component InfoPill inherits Rectangle {
    in property <string> label;
    in property <string> value;

    border-radius: 10px;
    background: #f2f4f7;
    horizontal-stretch: 1;

    VerticalLayout {
        alignment: center;
        padding-top: 8px; padding-bottom: 8px;
        padding-left: 6px; padding-right: 6px;
        spacing: 2px;
        Text { text: label; color: #667085; font-size: 11px; horizontal-alignment: center; }
        Text { text: value; color: #1f2937; font-size: 13px; font-weight: 700; horizontal-alignment: center; }
    }
}


export component AppWindow inherits Window {
    // ── properties ──────────────────────────────────────────────────────────
    in-out property <string> app-name: "闪记";
    in-out property <string> app-subtitle-text: "AI 语音输入工具";
    in-out property <string> status-text: "准备就绪";
    in-out property <string> hotkey-hint-title: "按下快捷键开始语音输入";
    in-out property <string> hotkey-hint-body: "把光标放到目标输入框，按住说话，松开后自动转写并粘贴";
    in-out property <string> hotkey-display-text: "RightCommand";

    in-out property <string> model-title-text: "Paraformer 中文";
    in-out property <string> model-desc-text: "中文普通话语音识别";
    in-out property <string> model-version-text: "v1.0.0";
    in-out property <string> model-size-text: "0 MB";
    in-out property <string> model-language-text: "ZH";
    in-out property <string> model-install-text: "模型已安装";
    in-out property <bool>   model-ready: true;
    in-out property <bool>   model-downloading: false;
    in-out property <float>  model-download-progress: 0.0;
    in-out property <string> model-download-status-text: "";
    in-out property <string> model-download-error-text: "";

    callback download-model-requested();

    in-out property <string> mic-permission-title: "麦克风权限已获取";
    in-out property <string> mic-permission-body: "已检测到 1 个可用输入设备";
    in-out property <bool>   mic-ready: true;
    in-out property <string> paste-permission-title: "自动粘贴已授权";
    in-out property <string> paste-permission-body: "已授权，可将识别结果自动粘贴到当前输入位置";
    in-out property <bool>   paste-ready: true;
    in-out property <string> default-device-text: "MacBook Pro麦克风";

    in-out property <string> transcribe-card-title: "语音转写测试";
    in-out property <string> transcribe-button-text: "点击测试录音";
    in-out property <string> transcribe-body-text: "测试转写功能是否正常";
    in-out property <string> audio-level-text: "0%";
    in-out property <float>  audio-level-value: 0.0;
    in-out property <string> monitor-button-text: "监听麦克风输入";
    in-out property <string> monitor-tip-text: "提示：日常使用无需打开此窗口，直接按快捷键即可";

    // kept for Rust binding compatibility
    in-out property <string> history-stats-text: "";
    in-out property <string> history-preview-text: "";
    in-out property <string> settings-summary-text: "";
    in-out property <string> rewrite-text: "";
    in-out property <string> tray-summary-text: "";
    in-out property <string> live-asr-text: "";
    in-out property <bool> show-settings-page: false;
    private property <bool> show-confirm-clear: false;
    in-out property <SettingsSection> active-section: SettingsSection.Asr;

    // settings page state
    in-out property <string> live-model-id: "paraformer-zh-streaming";
    in-out property <string> live-model-size-text: "约 220 MB";
    in-out property <bool>   live-model-downloaded: false;
    in-out property <bool>   live-model-downloading: false;
    in-out property <float>  live-model-download-progress: 0.0;
    in-out property <string> live-model-download-status-text: "";
    in-out property <bool>   refine-asr-enabled: false;
    in-out property <string> refine-model-id: "paraformer-zh";
    in-out property <string> refine-model-size-text: "约 240 MB";
    in-out property <bool>   refine-model-downloaded: false;
    in-out property <bool>   refine-model-downloading: false;
    in-out property <float>  refine-model-download-progress: 0.0;
    in-out property <string> refine-model-download-status-text: "";
    in-out property <string> refine-model-download-error-text: "";
    in-out property <string> refine-model-title-text: "Paraformer 离线纠正";
    in-out property <string> refine-model-desc-text: "整句离线纠正，提升识别准确度";
    in-out property <string> refine-model-version-text: "v1.0.0";
    in-out property <string> refine-model-language-text: "ZH";
    in property  <[HotwordLibraryCard]> hotword-libraries: [];
    in-out property <string> hotword-stats-text: "共 0 个词库";
    in-out property <string> hotword-dir-text: "";
    in-out property <string> hotword-hint-text: "";
    in property  <[string]>  audio-devices: [];
    in-out property <int>    audio-device-index: 0;
    in-out property <string> mic-test-status: "";
    in-out property <bool>   llm-enabled: false;
    in-out property <string> llm-base-url: "https://api.openai.com/v1";
    in-out property <bool>   llm-api-key-saved: false;
    in-out property <string> llm-model-name: "gpt-4o-mini";
    in-out property <string> llm-system-prompt: "";
    in-out property <string> llm-active-prompt-id: "default";
    in-out property <string> llm-provider-summary: "";
    in-out property <string> llm-test-status-text: "";
    in-out property <int>    llm-test-status-type: 0;
    in-out property <bool>   llm-testing: false;
    in-out property <string> hotkey-summary-text: "未设置";
    in-out property <string> hotkey-current-text: "未设置";
    in-out property <string> hotkey-help-text: "默认快捷键";
    in-out property <bool>   hotkey-recording: false;
    in-out property <int>    network-proxy-mode-index: 0;
    in-out property <int>    network-proxy-type-index: 0;
    in-out property <string> network-proxy-host: "";
    in-out property <string> network-proxy-port: "";
    in-out property <string> network-proxy-username: "";
    in-out property <bool>   network-proxy-password-saved: false;
    in-out property <string> network-proxy-test-status-text: "";
    in-out property <int>    network-proxy-test-status-type: 0;
    in-out property <bool>   network-proxy-testing: false;
    in property  <[HistoryCardData]> history-records: [];
    in-out property <string> app-version-text: "v0.1";
    in-out property <string> config-path-text: "";

    // Equal column width: (inner_content_width - 2*spacing) / 3
    // inner = VerticalLayout.width(= min(max(W-40,360),1180)) - 2*padding(20px) = VW - 40
    // card-col-width = (VW - 40 - 28) / 3
    property <length> card-col-width:
        (min(max(root.width - 40px, 360px), 1180px) - 68px) / 3;

    callback open-history-requested();
    callback open-settings-requested();
    callback close-settings-requested();
    callback toggle-live-asr-requested();
    callback toggle-mic-monitor-requested();
    callback request-mic-permission();
    callback toggle-refine-asr-requested();
    callback download-live-model-requested();
    callback download-refine-model-requested();
    callback toggle-hotword-library-requested(string);
    callback open-hotword-dir-requested();
    callback select-audio-device-requested(int);
    callback test-mic-requested();
    callback toggle-rewrite-requested();
    callback set-active-prompt-requested(string);
    callback open-llm-settings-requested();
    callback set-llm-base-url(string);
    callback set-llm-api-key(string);
    callback set-llm-model-name(string);
    callback set-llm-system-prompt(string);
    callback test-llm-api-requested();
    callback set-network-proxy-mode-requested(int);
    callback set-network-proxy-type-requested(int);
    callback set-network-proxy-host-requested(string);
    callback set-network-proxy-port-requested(string);
    callback set-network-proxy-username-requested(string);
    callback set-network-proxy-password-requested(string);
    callback test-network-proxy-requested();
    callback begin-hotkey-recording-requested();
    callback cancel-hotkey-recording-requested();
    callback hotkey-capture-key-pressed(string, bool, bool, bool, bool, bool);
    callback hotkey-capture-key-released(string, bool, bool, bool, bool);
    callback refresh-history-requested();
    callback clear-history-requested();
    callback play-audio-requested(int);
    callback retranscribe-requested(int);
    callback copy-record-requested(int);
    callback delete-record-requested(int);
    callback clear-session-requested();

    title: app-name;
    icon: @image-url("../assets/shanji_logo.png");
    width: 960px;
    height: 640px;
    default-font-family: "Hiragino Sans GB";
    in property <bool> compact-layout: root.width < 860px;

    Rectangle {
        background: #edf1f6;

        if root.show-settings-page: SettingsPage {
            width: parent.width;
            height: parent.height;
            show-back-button: true;

            active-section <=> root.active-section;
            live-model-id <=> root.live-model-id;
            live-model-size-text <=> root.live-model-size-text;
            live-model-downloaded <=> root.live-model-downloaded;
            live-model-downloading <=> root.live-model-downloading;
            live-model-download-progress <=> root.live-model-download-progress;
            live-model-download-status-text <=> root.live-model-download-status-text;
            refine-asr-enabled <=> root.refine-asr-enabled;
            refine-model-id <=> root.refine-model-id;
            refine-model-size-text <=> root.refine-model-size-text;
            refine-model-downloaded <=> root.refine-model-downloaded;
            refine-model-downloading <=> root.refine-model-downloading;
            refine-model-download-progress <=> root.refine-model-download-progress;
            refine-model-download-status-text <=> root.refine-model-download-status-text;
            hotword-libraries <=> root.hotword-libraries;
            hotword-stats-text <=> root.hotword-stats-text;
            hotword-dir-text <=> root.hotword-dir-text;
            hotword-hint-text <=> root.hotword-hint-text;
            audio-devices <=> root.audio-devices;
            audio-device-index <=> root.audio-device-index;
            mic-test-status <=> root.mic-test-status;
            llm-enabled <=> root.llm-enabled;
            llm-base-url <=> root.llm-base-url;
            llm-api-key-saved <=> root.llm-api-key-saved;
            llm-model-name <=> root.llm-model-name;
            llm-system-prompt <=> root.llm-system-prompt;
            llm-active-prompt-id <=> root.llm-active-prompt-id;
            llm-test-status-text <=> root.llm-test-status-text;
            llm-test-status-type <=> root.llm-test-status-type;
            llm-testing <=> root.llm-testing;
            hotkey-summary-text <=> root.hotkey-summary-text;
            hotkey-current-text <=> root.hotkey-current-text;
            hotkey-help-text <=> root.hotkey-help-text;
            hotkey-recording <=> root.hotkey-recording;
            network-proxy-mode-index <=> root.network-proxy-mode-index;
            network-proxy-type-index <=> root.network-proxy-type-index;
            network-proxy-host <=> root.network-proxy-host;
            network-proxy-port <=> root.network-proxy-port;
            network-proxy-username <=> root.network-proxy-username;
            network-proxy-password-saved <=> root.network-proxy-password-saved;
            network-proxy-test-status-text <=> root.network-proxy-test-status-text;
            network-proxy-test-status-type <=> root.network-proxy-test-status-type;
            network-proxy-testing <=> root.network-proxy-testing;
            history-records <=> root.history-records;
            history-stats-text <=> root.history-stats-text;
            app-version-text <=> root.app-version-text;
            config-path-text <=> root.config-path-text;

            back-requested => { root.close-settings-requested(); }
            toggle-refine-asr-requested => { root.toggle-refine-asr-requested(); }
            download-live-model-requested => { root.download-live-model-requested(); }
            download-refine-model-requested => { root.download-refine-model-requested(); }
            toggle-hotword-library-requested(id) => { root.toggle-hotword-library-requested(id); }
            open-hotword-dir-requested => { root.open-hotword-dir-requested(); }
            select-audio-device-requested(index) => { root.select-audio-device-requested(index); }
            test-mic-requested => { root.test-mic-requested(); }
            toggle-rewrite-requested => { root.toggle-rewrite-requested(); }
            set-active-prompt-requested(id) => { root.set-active-prompt-requested(id); }
            set-llm-base-url(url) => { root.set-llm-base-url(url); }
            set-llm-api-key(key) => { root.set-llm-api-key(key); }
            set-llm-model-name(model) => { root.set-llm-model-name(model); }
            set-llm-system-prompt(prompt) => { root.set-llm-system-prompt(prompt); }
            test-llm-api-requested => { root.test-llm-api-requested(); }
            set-network-proxy-mode-requested(index) => { root.set-network-proxy-mode-requested(index); }
            set-network-proxy-type-requested(index) => { root.set-network-proxy-type-requested(index); }
            set-network-proxy-host-requested(host) => { root.set-network-proxy-host-requested(host); }
            set-network-proxy-port-requested(port) => { root.set-network-proxy-port-requested(port); }
            set-network-proxy-username-requested(username) => { root.set-network-proxy-username-requested(username); }
            set-network-proxy-password-requested(password) => { root.set-network-proxy-password-requested(password); }
            test-network-proxy-requested => { root.test-network-proxy-requested(); }
            begin-hotkey-recording-requested => { root.begin-hotkey-recording-requested(); }
            cancel-hotkey-recording-requested => { root.cancel-hotkey-recording-requested(); }
            hotkey-capture-key-pressed(text, alt, control, shift, meta, repeat) => {
                root.hotkey-capture-key-pressed(text, alt, control, shift, meta, repeat);
            }
            hotkey-capture-key-released(text, alt, control, shift, meta) => {
                root.hotkey-capture-key-released(text, alt, control, shift, meta);
            }
            refresh-history-requested => { root.refresh-history-requested(); }
            clear-history-requested => { root.show-confirm-clear = true; }
            play-audio-requested(id) => { root.play-audio-requested(id); }
            retranscribe-requested(id) => { root.retranscribe-requested(id); }
            copy-record-requested(id) => { root.copy-record-requested(id); }
            delete-record-requested(id) => { root.delete-record-requested(id); }
            clear-session-requested => { root.clear-session-requested(); }
        }

        if root.show-confirm-clear: ConfirmDialog {
            title: "确认清空历史记录";
            description: "将永久删除全部历史记录，此操作不可撤销。";
            confirm-text: "清空全部";
            danger: true;
            confirmed => {
                root.show-confirm-clear = false;
                root.clear-history-requested();
            }
            cancelled => { root.show-confirm-clear = false; }
        }

        if !root.show-settings-page: ScrollView {
            width: parent.width;
            height: parent.height;

            content := Rectangle {
                width: root.width;
                background: transparent;

                VerticalLayout {
                    x: max((parent.width - self.width) / 2, 0px);
                    width: min(max(root.width - 40px, 360px), 1180px);
                    padding: 20px;
                    spacing: 14px;

                    // ════════════════════════════════════════════════════════
                    // Header — flat, blends into window background
                    // ════════════════════════════════════════════════════════
                    HorizontalLayout {
                        padding-top: 2px;
                        padding-bottom: 4px;
                        padding-left: 4px;
                        padding-right: 0px;
                        spacing: 10px;

                        Rectangle {
                            width: 46px; height: 46px;
                            border-radius: 13px;
                            border-width: 1.5px;
                            border-color: #b8cce4;
                            background: #ffffff;
                            clip: true;

                            Image {
                                width: parent.width;
                                height: parent.height;
                                source: @image-url("../assets/shanji_logo.png");
                                image-fit: cover;
                            }
                        }

                        VerticalLayout {
                            alignment: center;
                            spacing: 2px;
                            Text { text: app-name;          color: #1a2740; font-size: 16px; font-weight: 700; }
                            Text { text: app-subtitle-text;  color: #374151; font-size: 11px; }
                        }

                        Rectangle { horizontal-stretch: 1; background: transparent; }

                        HorizontalLayout {
                            alignment: end;
                            spacing: 4px;
                            GhostIconButton {
                                icon-path: Icons.clock;
                                clicked => { root.open-history-requested(); }
                            }
                            GhostIconButton {
                                icon-path: Icons.sliders;
                                clicked => { root.open-settings-requested(); }
                            }
                        }
                    }

                    // ════════════════════════════════════════════════════════
                    // Hotkey banner
                    // ════════════════════════════════════════════════════════
                    Rectangle {
                        border-radius: 18px;
                        background: #e8f3ff;
                        border-width: 1px;
                        border-color: #b9d8ff;

                        HorizontalLayout {
                            padding: 16px;
                            spacing: 14px;

                            Rectangle {
                                width: 46px; height: 46px;
                                border-radius: 13px;
                                background: #2962ff;

                                Path {
                                    x: (parent.width - self.width) / 2;
                                    y: (parent.height - self.height) / 2;
                                    width: 26px; height: 26px;
                                    viewbox-width: 24; viewbox-height: 24;
                                    commands: Icons.keyboard;
                                    stroke: #ffffff;
                                    stroke-width: 2px;
                                    fill: transparent;
                                }
                            }

                            VerticalLayout {
                                alignment: center;
                                spacing: 5px;
                                Text { text: hotkey-hint-title; color: #2563eb; font-size: 15px; font-weight: 700; }
                                Text { text: hotkey-hint-body;  color: #475467; font-size: 13px; wrap: word-wrap; }
                            }

                            Rectangle { horizontal-stretch: 1; background: transparent; }

                            Rectangle {
                                border-radius: 10px;
                                background: #ffffff;
                                border-width: 1.5px;
                                border-color: #d0d5dd;

                                VerticalLayout {
                                    padding-top: 12px; padding-bottom: 12px;
                                    padding-left: 20px; padding-right: 20px;
                                    Text {
                                        text: hotkey-display-text;
                                        color: #1d2939;
                                        horizontal-alignment: center;
                                        font-size: 15px;
                                        font-weight: 700;
                                    }
                                }
                            }
                        }
                    }

                    // ════════════════════════════════════════════════════════
                    // Mic / paste status strip
                    // ════════════════════════════════════════════════════════
                    status-strip := Rectangle {
                        border-radius: 10px;
                        background: mic-ready && paste-ready ? #f8fafc : #fff7ed;
                        border-width: 1px;
                        border-color: mic-ready && paste-ready ? #e2e8f0 : #fed7aa;
                        height: 44px;

                        property <bool> mic-testing: false;

                        HorizontalLayout {
                            padding-left: 14px; padding-right: 14px;
                            spacing: 0px;

                            // ── 左侧：授权信息（靠左对齐）─────────────────
                            HorizontalLayout {
                                spacing: 8px;
                                alignment: start;

                                Text {
                                    text: "授权：";
                                    color: #6b7280;
                                    font-size: 12px;
                                    font-weight: 700;
                                    vertical-alignment: center;
                                }

                                // 麦克风状态
                                HorizontalLayout {
                                    spacing: 4px;
                                    alignment: center;
                                    Text {
                                        text: mic-ready ? "✓" : "✗";
                                        color: mic-ready ? #059669 : #dc2626;
                                        font-size: 12px;
                                        font-weight: 700;
                                        vertical-alignment: center;
                                    }
                                    Text {
                                        text: mic-ready ? "麦克风已授权" : "麦克风未授权";
                                        color: mic-ready ? #059669 : #dc2626;
                                        font-size: 12px;
                                        font-weight: mic-ready ? 400 : 700;
                                        vertical-alignment: center;
                                    }
                                }

                                // 若麦克风未授权显示授权按钮
                                if !mic-ready: VerticalLayout {
                                    alignment: center;
                                    Rectangle {
                                        width: 68px; height: 22px;
                                        border-radius: 5px;
                                        background: mic-auth-strip-ta.has-hover ? #1d4ed8 : #2563eb;
                                        mic-auth-strip-ta := TouchArea {
                                            clicked => { root.request-mic-permission(); }
                                        }
                                        Text {
                                            text: "前往授权";
                                            color: #ffffff;
                                            font-size: 11px;
                                            font-weight: 700;
                                            horizontal-alignment: center;
                                            vertical-alignment: center;
                                        }
                                    }
                                }

                                // 竖线分隔
                                VerticalLayout {
                                    alignment: center;
                                    Rectangle {
                                        width: 1px; height: 16px;
                                        background: #d1d5db;
                                    }
                                }

                                // 自动粘贴状态
                                HorizontalLayout {
                                    spacing: 4px;
                                    alignment: center;
                                    Text {
                                        text: paste-ready ? "✓" : "✗";
                                        color: paste-ready ? #059669 : #dc2626;
                                        font-size: 12px;
                                        font-weight: 700;
                                        vertical-alignment: center;
                                    }
                                    Text {
                                        text: "自动粘贴";
                                        color: paste-ready ? #059669 : #dc2626;
                                        font-size: 12px;
                                        vertical-alignment: center;
                                    }
                                }
                            }

                            // ── 弹性间距 ────────────────────────────────────
                            Rectangle { horizontal-stretch: 1; background: transparent; }

                            // ── 右侧：音频设备 + 测试按钮 + 竖向音量柱 ────
                            HorizontalLayout {
                                spacing: 10px;
                                alignment: end;

                                Text {
                                    text: "音频设备：" + default-device-text;
                                    color: #6b7280;
                                    font-size: 12px;
                                    vertical-alignment: center;
                                }

                                // 测试 / 停止 按钮（描边风格）
                                VerticalLayout {
                                    alignment: center;
                                    Rectangle {
                                        width: 48px; height: 22px;
                                        border-radius: 5px;
                                        border-width: 1px;
                                        border-color: status-strip.mic-testing ? #fca5a5 : #93c5fd;
                                        background: test-mic-ta.has-hover
                                            ? (status-strip.mic-testing ? #fef2f2 : #eff6ff)
                                            : (status-strip.mic-testing ? transparent : #f0f7ff);
                                        test-mic-ta := TouchArea {
                                            mouse-cursor: pointer;
                                            clicked => {
                                                status-strip.mic-testing = !status-strip.mic-testing;
                                                root.toggle-mic-monitor-requested();
                                            }
                                        }
                                        Text {
                                            text: status-strip.mic-testing ? "停止" : "测试";
                                            color: status-strip.mic-testing ? #dc2626 : #2563eb;
                                            font-size: 11px;
                                            font-weight: 400;
                                            horizontal-alignment: center;
                                            vertical-alignment: center;
                                        }
                                    }
                                }

                                // 竖向音量柱（固定位置，始终显示）
                                VerticalLayout {
                                    alignment: center;
                                    Rectangle {
                                        width: 10px; height: 20px;
                                        border-radius: 3px;
                                        background: #e5e7eb;
                                        // 填充块从底部向上增长
                                        Rectangle {
                                            width: 10px;
                                            border-radius: 3px;
                                            height: status-strip.mic-testing
                                                ? parent.height * audio-level-value
                                                : 0px;
                                            y: parent.height - self.height;
                                            background: status-strip.mic-testing
                                                ? (audio-level-value > 0.7 ? #ef4444
                                                    : (audio-level-value > 0.3 ? #f59e0b : #22c55e))
                                                : transparent;
                                        }
                                    }
                                }
                            }
                        }
                    }

                    // ════════════════════════════════════════════════════════
                    // Three status cards — wide layout
                    // ════════════════════════════════════════════════════════
                    if !root.compact-layout : HorizontalLayout {
                        spacing: 14px;

                        // ── 模型状态 ──────────────────────────────────────
                        Rectangle {
                            border-radius: 18px;
                            background: #ffffff;
                            border-width: 1px;
                            border-color: #d7dee8;
                            width: card-col-width;

                            VerticalLayout {
                                padding: 18px;
                                spacing: 10px;

                                // title row
                                HorizontalLayout {
                                    spacing: 7px;
                                    SvgIcon { commands: Icons.zap; icon-color: #0d9488; }
                                    Text { text: "实时模型（必需）"; color: #1f2937; font-size: 14px; font-weight: 700; vertical-alignment: center; }
                                    Text { text: "●"; color: model-ready ? #22c55e : #ef4444; font-size: 9px; vertical-alignment: center; }
                                    Rectangle { horizontal-stretch: 1; background: transparent; }
                                    if model-ready : Rectangle {
                                        border-radius: 6px;
                                        background: #d1fae5;
                                        border-width: 1px;
                                        border-color: #6ee7b7;
                                        HorizontalLayout {
                                            padding-left: 8px; padding-right: 8px;
                                            padding-top: 3px; padding-bottom: 3px;
                                            Text { text: "已加载"; color: #065f46; font-size: 11px; font-weight: 700; vertical-alignment: center; }
                                        }
                                    }
                                    if model-downloading : Rectangle {
                                        border-radius: 6px;
                                        background: #eff6ff;
                                        border-width: 1px;
                                        border-color: #93c5fd;
                                        HorizontalLayout {
                                            padding-left: 8px; padding-right: 8px;
                                            padding-top: 3px; padding-bottom: 3px;
                                            Text { text: "下载中"; color: #1d4ed8; font-size: 11px; font-weight: 700; vertical-alignment: center; }
                                        }
                                    }
                                    if !model-ready && !model-downloading : Rectangle {
                                        border-radius: 6px;
                                        background: #fef3c7;
                                        border-width: 1px;
                                        border-color: #fcd34d;
                                        HorizontalLayout {
                                            padding-left: 8px; padding-right: 8px;
                                            padding-top: 3px; padding-bottom: 3px;
                                            Text { text: "未下载"; color: #92400e; font-size: 11px; font-weight: 700; vertical-alignment: center; }
                                        }
                                    }
                                }

                                // model name + description
                                VerticalLayout {
                                    spacing: 4px;
                                    Text { text: model-title-text; color: #1f2937; font-size: 17px; font-weight: 700; }
                                    Text { text: model-desc-text;  color: #667085; font-size: 12px; wrap: word-wrap; }
                                }

                                // version / size / language pills
                                HorizontalLayout {
                                    spacing: 8px;
                                    InfoPill { label: "版本"; value: model-version-text; }
                                    InfoPill { label: "大小"; value: model-size-text;    }
                                    InfoPill { label: "语言"; value: model-language-text; }
                                }

                                // install badge — installed
                                if model-ready : Rectangle {
                                    border-radius: 10px;
                                    background: #dff6e8;
                                    height: 40px;
                                    Text {
                                        text: "✓  模型已安装";
                                        color: #1a7f45;
                                        horizontal-alignment: center;
                                        vertical-alignment: center;
                                        font-size: 13px;
                                        font-weight: 700;
                                    }
                                }

                                // download progress bar
                                if model-downloading : VerticalLayout {
                                    spacing: 6px;
                                    padding-top: 4px;
                                    Text {
                                        text: model-download-status-text;
                                        color: #374151;
                                        font-size: 12px;
                                        horizontal-alignment: center;
                                    }
                                    Rectangle {
                                        height: 8px;
                                        border-radius: 4px;
                                        background: #e5e7eb;
                                        Rectangle {
                                            height: 8px;
                                            border-radius: 4px;
                                            background: #0d9488;
                                            x: 0;
                                            width: parent.width * root.model-download-progress;
                                        }
                                    }
                                }

                                // download button — not installed, not downloading
                                if !model-ready && !model-downloading : Rectangle {
                                    border-radius: 10px;
                                    background: dl-ta.has-hover ? #dbeafe : #eff6ff;
                                    border-width: 1px;
                                    border-color: #93c5fd;
                                    height: 40px;
                                    dl-ta := TouchArea { clicked => { root.download-model-requested(); } }
                                    Text {
                                        text: "↓  下载模型";
                                        color: #1d4ed8;
                                        horizontal-alignment: center;
                                        vertical-alignment: center;
                                        font-size: 13px;
                                        font-weight: 700;
                                    }
                                }

                                // error message after failed download
                                if !model-ready && !model-downloading && model-download-error-text != "" : Rectangle {
                                    border-radius: 8px;
                                    background: #fef2f2;
                                    border-width: 1px;
                                    border-color: #fecaca;
                                    VerticalLayout {
                                        padding: 8px;
                                        Text {
                                            text: "下载失败：" + model-download-error-text;
                                            color: #b91c1c;
                                            font-size: 11px;
                                            wrap: word-wrap;
                                        }
                                    }
                                }
                                Rectangle { vertical-stretch: 1; background: transparent; }
                                Text {
                                    text: "软件运行必需依赖，下载后方可使用该软件";
                                    color: #3b82f6;
                                    font-size: 11px;
                                    wrap: word-wrap;
                                    horizontal-alignment: center;
                                }
                            }
                        }

                        // ── 纠正模型状态 ──────────────────────────────────
                        Rectangle {
                            border-radius: 18px;
                            background: #ffffff;
                            border-width: 1px;
                            border-color: #d7dee8;
                            width: card-col-width;

                            VerticalLayout {
                                padding: 18px;
                                spacing: 10px;

                                // title row
                                HorizontalLayout {
                                    spacing: 7px;
                                    SvgIcon { commands: Icons.layers; icon-color: #f59e0b; }
                                    Text { text: "离线模型（可选）"; color: #1f2937; font-size: 14px; font-weight: 700; vertical-alignment: center; }
                                    Text {
                                        text: "●";
                                        color: refine-model-downloading ? #3b82f6
                                            : refine-model-downloaded && refine-asr-enabled ? #22c55e
                                            : refine-model-downloaded ? #9ca3af
                                            : #ef4444;
                                        font-size: 9px;
                                        vertical-alignment: center;
                                    }
                                    Rectangle { horizontal-stretch: 1; background: transparent; }
                                    Rectangle {
                                        width: 36px;
                                        height: 20px;
                                        border-radius: 10px;
                                        background: refine-asr-enabled ? #22c55e : #d1d5db;
                                        refine-toggle-ta := TouchArea {
                                            clicked => { root.toggle-refine-asr-requested(); }
                                        }
                                        Rectangle {
                                            width: 16px; height: 16px;
                                            border-radius: 8px;
                                            background: #ffffff;
                                            x: refine-asr-enabled ? 18px : 2px;
                                            y: 2px;
                                        }
                                    }
                                }

                                // model name + description
                                VerticalLayout {
                                    spacing: 4px;
                                    Text { text: refine-model-title-text; color: #1f2937; font-size: 17px; font-weight: 700; }
                                    Text { text: refine-model-desc-text;  color: #667085; font-size: 12px; wrap: word-wrap; }
                                }

                                // version / size / language pills
                                HorizontalLayout {
                                    spacing: 8px;
                                    InfoPill { label: "版本"; value: refine-model-version-text; }
                                    InfoPill { label: "大小"; value: refine-model-size-text;    }
                                    InfoPill { label: "语言"; value: refine-model-language-text; }
                                }

                                // green: enabled + downloaded
                                if refine-model-downloaded && refine-asr-enabled : Rectangle {
                                    border-radius: 10px;
                                    background: #dff6e8;
                                    height: 40px;
                                    Text {
                                        text: "模型已启用已下载";
                                        color: #1a7f45;
                                        horizontal-alignment: center;
                                        vertical-alignment: center;
                                        font-size: 13px;
                                        font-weight: 700;
                                    }
                                }

                                // orange: downloaded + not enabled
                                if refine-model-downloaded && !refine-asr-enabled : Rectangle {
                                    border-radius: 10px;
                                    background: #fff7ed;
                                    border-width: 1px;
                                    border-color: #fed7aa;
                                    height: 40px;
                                    Text {
                                        text: "模型未启用已下载";
                                        color: #c2410c;
                                        horizontal-alignment: center;
                                        vertical-alignment: center;
                                        font-size: 13px;
                                        font-weight: 700;
                                    }
                                }

                                // download progress bar
                                if refine-model-downloading : VerticalLayout {
                                    spacing: 6px;
                                    padding-top: 4px;
                                    Text {
                                        text: refine-model-download-status-text;
                                        color: #374151;
                                        font-size: 12px;
                                        horizontal-alignment: center;
                                    }
                                    Rectangle {
                                        height: 8px;
                                        border-radius: 4px;
                                        background: #e5e7eb;
                                        Rectangle {
                                            height: 8px;
                                            border-radius: 4px;
                                            background: #f59e0b;
                                            x: 0;
                                            width: parent.width * root.refine-model-download-progress;
                                        }
                                    }
                                }

                                // download button: enabled but not downloaded
                                if !refine-model-downloaded && !refine-model-downloading && refine-asr-enabled : Rectangle {
                                    border-radius: 10px;
                                    background: rdl-ta.has-hover ? #dbeafe : #eff6ff;
                                    border-width: 1px;
                                    border-color: #93c5fd;
                                    height: 40px;
                                    rdl-ta := TouchArea { clicked => { root.download-refine-model-requested(); } }
                                    Text {
                                        text: "↓  下载模型";
                                        color: #1d4ed8;
                                        horizontal-alignment: center;
                                        vertical-alignment: center;
                                        font-size: 13px;
                                        font-weight: 700;
                                    }
                                }

                                // gray: not enabled, not downloaded
                                if !refine-model-downloaded && !refine-model-downloading && !refine-asr-enabled : Rectangle {
                                    border-radius: 10px;
                                    background: #f3f4f6;
                                    border-width: 1px;
                                    border-color: #e5e7eb;
                                    height: 40px;
                                    Text {
                                        text: "模型未启用";
                                        color: #6b7280;
                                        horizontal-alignment: center;
                                        vertical-alignment: center;
                                        font-size: 13px;
                                        font-weight: 700;
                                    }
                                }

                                // error after failed download
                                if !refine-model-downloaded && !refine-model-downloading && refine-model-download-error-text != "" : Rectangle {
                                    border-radius: 8px;
                                    background: #fef2f2;
                                    border-width: 1px;
                                    border-color: #fecaca;
                                    VerticalLayout {
                                        padding: 8px;
                                        Text {
                                            text: "下载失败：" + refine-model-download-error-text;
                                            color: #b91c1c;
                                            font-size: 11px;
                                            wrap: word-wrap;
                                        }
                                    }
                                }
                                Rectangle { vertical-stretch: 1; background: transparent; }
                                Text {
                                    text: "离线模型可选择性下载，不影响软件使用";
                                    color: #3b82f6;
                                    font-size: 11px;
                                    wrap: word-wrap;
                                    horizontal-alignment: center;
                                }
                            }
                        }

                        // ── LLM 润色 ──────────────────────────────────────
                        Rectangle {
                            border-radius: 18px;
                            background: #ffffff;
                            border-width: 1px;
                            border-color: #d7dee8;
                            width: card-col-width;

                            VerticalLayout {
                                padding: 18px;
                                spacing: 10px;

                                // title row: icon + label + dot + toggle
                                HorizontalLayout {
                                    spacing: 7px;
                                    height: 22px;
                                    SvgIcon { commands: Icons.sparkles; icon-color: #7c3aed; }
                                    Text { text: "LLM 润色（建议）"; color: #1f2937; font-size: 14px; font-weight: 700; vertical-alignment: center; }
                                    Text {
                                        text: "●";
                                        color: llm-enabled ? #22c55e : #9ca3af;
                                        font-size: 9px; vertical-alignment: center;
                                    }
                                    Rectangle { horizontal-stretch: 1; background: transparent; }
                                    Rectangle {
                                        width: 36px; height: 20px; border-radius: 10px;
                                        background: llm-enabled ? #7c3aed : #d1d5db;
                                        llm-toggle-ta := TouchArea {
                                            clicked => { root.toggle-rewrite-requested(); }
                                        }
                                        Rectangle {
                                            width: 16px; height: 16px; border-radius: 8px;
                                            background: #ffffff;
                                            x: llm-enabled ? 18px : 2px; y: 2px;
                                        }
                                    }
                                }

                                // provider name — big like model name
                                VerticalLayout {
                                    spacing: 3px;
                                    Text {
                                        text: llm-provider-summary == "" ? "模型未配置" : llm-provider-summary;
                                        color: llm-enabled
                                            ? (llm-provider-summary == "" ? #dc2626 : #1f2937)
                                            : #9ca3af;
                                        font-size: 17px;
                                        font-weight: 700;
                                    }
                                    Text {
                                        text: llm-enabled ? "大模型对转录文本进行智能润色改写" : "润色功能已关闭，将直接输出语音输入结果";
                                        color: #667085;
                                        font-size: 12px;
                                        wrap: word-wrap;
                                    }
                                }

                                // style selector row
                                VerticalLayout {
                                    spacing: 5px;
                                    Text {
                                        text: "润色风格";
                                        color: llm-enabled ? #9ca3af : #d1d5db;
                                        font-size: 11px;
                                    }
                                    HorizontalLayout {
                                        spacing: 5px;
                                        alignment: start;

                                        for chip-info in [
                                            {id: "default", label: "结构化"},
                                            {id: "light",   label: "轻度整理"},
                                            {id: "formal",  label: "书面化"},
                                            {id: "custom",  label: "自定义"}
                                        ]: Rectangle {
                                            property <bool> is-active: llm-active-prompt-id == chip-info.id;
                                            border-radius: 7px;
                                            background: is-active ? #7c3aed
                                                : (llm-enabled ? #f3f4f6 : #f9fafb);
                                            border-width: is-active ? 0px : 1px;
                                            border-color: #e5e7eb;
                                            height: 28px;

                                            chip-ta := TouchArea {
                                                enabled: llm-enabled;
                                                clicked => { root.set-active-prompt-requested(chip-info.id); }
                                                mouse-cursor: pointer;
                                            }

                                            HorizontalLayout {
                                                padding-left: 9px; padding-right: 9px;
                                                alignment: center;
                                                Text {
                                                    text: chip-info.label;
                                                    color: is-active ? #ffffff
                                                        : (llm-enabled ? #374151 : #d1d5db);
                                                    font-size: 11px;
                                                    font-weight: is-active ? 700 : 400;
                                                    vertical-alignment: center;
                                                }
                                            }
                                        }
                                    }
                                    Text {
                                        text: llm-active-prompt-id == "default" ? "归纳总结，结构化表达，善用编号条目"
                                            : (llm-active-prompt-id == "light" ? "最少干预，修正标点错误，忠实保留原意"
                                            : (llm-active-prompt-id == "formal" ? "适合邮件与文档，正式规范的书面风格"
                                            : "使用下方自定义提示词"));
                                        color: llm-enabled ? #9ca3af : #d1d5db;
                                        font-size: 10px;
                                    }
                                }

                                // settings link button — full width like model status badge
                                Rectangle {
                                    border-radius: 10px;
                                    background: llm-goto-ta.has-hover ? #ede9fe : #f5f3ff;
                                    border-width: 1px;
                                    border-color: #ddd6fe;
                                    height: 40px;

                                    llm-goto-ta := TouchArea {
                                        clicked => { root.open-llm-settings-requested(); }
                                        mouse-cursor: pointer;
                                    }

                                    Text {
                                        text: "配置 API 与提示词  →";
                                        color: #6d28d9;
                                        horizontal-alignment: center;
                                        vertical-alignment: center;
                                        font-size: 13px;
                                        font-weight: 700;
                                    }
                                }
                                Rectangle { vertical-stretch: 1; background: transparent; }
                                Text {
                                    text: "建议开启，可显著提升输入效率和准确性";
                                    color: #3b82f6;
                                    font-size: 11px;
                                    wrap: word-wrap;
                                    horizontal-alignment: center;
                                }
                            }
                        }
                    }

                    // ════════════════════════════════════════════════════════
                    // Tips row (wide layout only)
                    // ════════════════════════════════════════════════════════
                    if !root.compact-layout : HorizontalLayout {
                        spacing: 14px;

                        Rectangle {
                            border-radius: 14px; background: #f0fdf4;
                            border-width: 1px; border-color: #bbf7d0;
                            width: card-col-width;
                            VerticalLayout {
                                alignment: start; padding: 14px; spacing: 6px;
                                HorizontalLayout {
                                    spacing: 6px;
                                    SvgIcon { commands: Icons.shield-check; icon-color: #16a34a; }
                                    Text { text: "本地离线识别"; color: #15803d; font-size: 13px; font-weight: 700; vertical-alignment: center; }
                                }
                                Text {
                                    text: "音频在本机处理，不上传任何语音数据，隐私完全可控";
                                    color: #4b7c5c; font-size: 12px; wrap: word-wrap;
                                }
                            }
                        }

                        Rectangle {
                            border-radius: 14px; background: #eff6ff;
                            border-width: 1px; border-color: #bfdbfe;
                            width: card-col-width;
                            VerticalLayout {
                                alignment: start; padding: 14px; spacing: 6px;
                                HorizontalLayout {
                                    spacing: 6px;
                                    SvgIcon { commands: Icons.send; icon-color: #2563eb; }
                                    Text { text: "全自动粘贴"; color: #1d4ed8; font-size: 13px; font-weight: 700; vertical-alignment: center; }
                                }
                                Text {
                                    text: "松开快捷键后，转写结果自动写入当前焦点输入框，无需手动复制";
                                    color: #3b5ea6; font-size: 12px; wrap: word-wrap;
                                }
                            }
                        }

                        Rectangle {
                            border-radius: 14px; background: #faf5ff;
                            border-width: 1px; border-color: #e9d5ff;
                            width: card-col-width;
                            VerticalLayout {
                                alignment: start; padding: 14px; spacing: 6px;
                                HorizontalLayout {
                                    spacing: 6px;
                                    SvgIcon { commands: Icons.sparkles; icon-color: #7c3aed; }
                                    Text { text: "LLM润色"; color: #6d28d9; font-size: 13px; font-weight: 700; vertical-alignment: center; }
                                }
                                Text {
                                    text: "可在设置中开启 LLM 润色，对最终文本做纠错、书面化和风格整理";
                                    color: #5b3e8e; font-size: 12px; wrap: word-wrap;
                                }
                            }
                        }
                    }

                    // ════════════════════════════════════════════════════════
                    // Three status cards — compact (stacked) layout
                    // ════════════════════════════════════════════════════════
                    if root.compact-layout : VerticalLayout {
                        spacing: 14px;

                        // 模型状态
                        Rectangle {
                            border-radius: 18px; background: #ffffff;
                            border-width: 1px; border-color: #d7dee8;                            VerticalLayout {
                                padding: 18px; spacing: 10px;
                                HorizontalLayout {
                                    spacing: 7px;
                                    SvgIcon { commands: Icons.zap; icon-color: #0d9488; }
                                    Text { text: "实时模型（必需）"; color: #1f2937; font-size: 14px; font-weight: 700; vertical-alignment: center; }
                                    Text { text: "●"; color: model-ready ? #22c55e : #ef4444; font-size: 9px; vertical-alignment: center; }
                                    Rectangle { horizontal-stretch: 1; background: transparent; }
                                    if model-ready : Rectangle {
                                        border-radius: 6px;
                                        background: #d1fae5;
                                        border-width: 1px;
                                        border-color: #6ee7b7;
                                        HorizontalLayout {
                                            padding-left: 8px; padding-right: 8px;
                                            padding-top: 3px; padding-bottom: 3px;
                                            Text { text: "已加载"; color: #065f46; font-size: 11px; font-weight: 700; vertical-alignment: center; }
                                        }
                                    }
                                    if model-downloading : Rectangle {
                                        border-radius: 6px;
                                        background: #eff6ff;
                                        border-width: 1px;
                                        border-color: #93c5fd;
                                        HorizontalLayout {
                                            padding-left: 8px; padding-right: 8px;
                                            padding-top: 3px; padding-bottom: 3px;
                                            Text { text: "下载中"; color: #1d4ed8; font-size: 11px; font-weight: 700; vertical-alignment: center; }
                                        }
                                    }
                                    if !model-ready && !model-downloading : Rectangle {
                                        border-radius: 6px;
                                        background: #fef3c7;
                                        border-width: 1px;
                                        border-color: #fcd34d;
                                        HorizontalLayout {
                                            padding-left: 8px; padding-right: 8px;
                                            padding-top: 3px; padding-bottom: 3px;
                                            Text { text: "未下载"; color: #92400e; font-size: 11px; font-weight: 700; vertical-alignment: center; }
                                        }
                                    }
                                }
                                VerticalLayout {
                                    spacing: 4px;
                                    Text { text: model-title-text; color: #1f2937; font-size: 17px; font-weight: 700; }
                                    Text { text: model-desc-text;  color: #667085; font-size: 12px; wrap: word-wrap; }
                                }
                                HorizontalLayout {
                                    spacing: 8px;
                                    InfoPill { label: "版本"; value: model-version-text; }
                                    InfoPill { label: "大小"; value: model-size-text;    }
                                    InfoPill { label: "语言"; value: model-language-text; }
                                }
                                if model-ready : Rectangle {
                                    border-radius: 10px; background: #dff6e8; height: 40px;
                                    Text {
                                        text: "✓  模型已安装";
                                        color: #1a7f45;
                                        horizontal-alignment: center; vertical-alignment: center;
                                        font-size: 13px; font-weight: 700;
                                    }
                                }
                                if model-downloading : VerticalLayout {
                                    spacing: 6px; padding-top: 4px;
                                    Text { text: model-download-status-text; color: #374151; font-size: 12px; horizontal-alignment: center; }
                                    Rectangle {
                                        height: 8px; border-radius: 4px; background: #e5e7eb;
                                        Rectangle { height: 8px; border-radius: 4px; background: #0d9488; width: parent.width * root.model-download-progress; }
                                    }
                                }
                                if !model-ready && !model-downloading : Rectangle {
                                    border-radius: 10px;
                                    background: cdl-ta.has-hover ? #dbeafe : #eff6ff;
                                    border-width: 1px; border-color: #93c5fd; height: 40px;
                                    cdl-ta := TouchArea { clicked => { root.download-model-requested(); } }
                                    Text {
                                        text: "↓  下载模型"; color: #1d4ed8;
                                        horizontal-alignment: center; vertical-alignment: center;
                                        font-size: 13px; font-weight: 700;
                                    }
                                }
                                if !model-ready && !model-downloading && model-download-error-text != "" : Rectangle {
                                    border-radius: 8px; background: #fef2f2;
                                    border-width: 1px; border-color: #fecaca;
                                    VerticalLayout {
                                        padding: 8px;
                                        Text {
                                            text: "下载失败：" + model-download-error-text;
                                            color: #b91c1c; font-size: 11px; wrap: word-wrap;
                                        }
                                    }
                                }
                                Rectangle { vertical-stretch: 1; background: transparent; }
                                Text {
                                    text: "软件运行必需依赖，下载后方可使用该软件";
                                    color: #3b82f6; font-size: 11px; wrap: word-wrap;
                                    horizontal-alignment: center;
                                }
                            }
                        }

                        // 离线模型（可选）
                        Rectangle {
                            border-radius: 18px; background: #ffffff;
                            border-width: 1px; border-color: #d7dee8;
                            VerticalLayout {
                                padding: 18px; spacing: 10px;
                                HorizontalLayout {
                                    spacing: 7px;
                                    SvgIcon { commands: Icons.layers; icon-color: #f59e0b; }
                                    Text { text: "离线模型（可选）"; color: #1f2937; font-size: 14px; font-weight: 700; vertical-alignment: center; }
                                    Text {
                                        text: "●";
                                        color: refine-model-downloading ? #3b82f6
                                            : refine-model-downloaded && refine-asr-enabled ? #22c55e
                                            : refine-model-downloaded ? #9ca3af
                                            : #ef4444;
                                        font-size: 9px; vertical-alignment: center;
                                    }
                                    Rectangle { horizontal-stretch: 1; background: transparent; }
                                    Rectangle {
                                        width: 36px; height: 20px; border-radius: 10px;
                                        background: refine-asr-enabled ? #22c55e : #d1d5db;
                                        compact-refine-toggle-ta := TouchArea {
                                            clicked => { root.toggle-refine-asr-requested(); }
                                        }
                                        Rectangle {
                                            width: 16px; height: 16px; border-radius: 8px;
                                            background: #ffffff;
                                            x: refine-asr-enabled ? 18px : 2px; y: 2px;
                                        }
                                    }
                                }
                                VerticalLayout {
                                    spacing: 4px;
                                    Text { text: refine-model-title-text; color: #1f2937; font-size: 17px; font-weight: 700; }
                                    Text { text: refine-model-desc-text;  color: #667085; font-size: 12px; wrap: word-wrap; }
                                }
                                HorizontalLayout {
                                    spacing: 8px;
                                    InfoPill { label: "版本"; value: refine-model-version-text; }
                                    InfoPill { label: "大小"; value: refine-model-size-text;    }
                                    InfoPill { label: "语言"; value: refine-model-language-text; }
                                }
                                // green: enabled + downloaded
                                if refine-model-downloaded && refine-asr-enabled : Rectangle {
                                    border-radius: 10px; background: #dff6e8; height: 40px;
                                    Text {
                                        text: "模型已启用已下载"; color: #1a7f45;
                                        horizontal-alignment: center; vertical-alignment: center;
                                        font-size: 13px; font-weight: 700;
                                    }
                                }
                                // orange: downloaded + not enabled
                                if refine-model-downloaded && !refine-asr-enabled : Rectangle {
                                    border-radius: 10px; background: #fff7ed;
                                    border-width: 1px; border-color: #fed7aa; height: 40px;
                                    Text {
                                        text: "模型未启用已下载"; color: #c2410c;
                                        horizontal-alignment: center; vertical-alignment: center;
                                        font-size: 13px; font-weight: 700;
                                    }
                                }
                                if refine-model-downloading : VerticalLayout {
                                    spacing: 6px; padding-top: 4px;
                                    Text { text: refine-model-download-status-text; color: #374151; font-size: 12px; horizontal-alignment: center; }
                                    Rectangle {
                                        height: 8px; border-radius: 4px; background: #e5e7eb;
                                        Rectangle { height: 8px; border-radius: 4px; background: #f59e0b; x: 0; width: parent.width * root.refine-model-download-progress; }
                                    }
                                }
                                // download button: enabled but not downloaded
                                if !refine-model-downloaded && !refine-model-downloading && refine-asr-enabled : Rectangle {
                                    border-radius: 10px;
                                    background: crdl-ta.has-hover ? #dbeafe : #eff6ff;
                                    border-width: 1px; border-color: #93c5fd; height: 40px;
                                    crdl-ta := TouchArea { clicked => { root.download-refine-model-requested(); } }
                                    Text {
                                        text: "↓  下载模型"; color: #1d4ed8;
                                        horizontal-alignment: center; vertical-alignment: center;
                                        font-size: 13px; font-weight: 700;
                                    }
                                }
                                // gray: not enabled, not downloaded
                                if !refine-model-downloaded && !refine-model-downloading && !refine-asr-enabled : Rectangle {
                                    border-radius: 10px; background: #f3f4f6;
                                    border-width: 1px; border-color: #e5e7eb; height: 40px;
                                    Text {
                                        text: "模型未启用"; color: #6b7280;
                                        horizontal-alignment: center; vertical-alignment: center;
                                        font-size: 13px; font-weight: 700;
                                    }
                                }
                                if !refine-model-downloaded && !refine-model-downloading && refine-model-download-error-text != "" : Rectangle {
                                    border-radius: 8px; background: #fef2f2;
                                    border-width: 1px; border-color: #fecaca;
                                    VerticalLayout {
                                        padding: 8px;
                                        Text { text: "下载失败：" + refine-model-download-error-text; color: #b91c1c; font-size: 11px; wrap: word-wrap; }
                                    }
                                }
                                Rectangle { vertical-stretch: 1; background: transparent; }
                                Text {
                                    text: "离线模型可选择性下载，不影响软件使用";
                                    color: #3b82f6; font-size: 11px; wrap: word-wrap;
                                    horizontal-alignment: center;
                                }
                            }
                        }

                        // LLM 润色（compact）
                        Rectangle {
                            border-radius: 18px; background: #ffffff;
                            border-width: 1px; border-color: #d7dee8;
                            VerticalLayout {
                                padding: 18px; spacing: 10px;
                                HorizontalLayout {
                                    spacing: 7px; height: 22px;
                                    SvgIcon { commands: Icons.sparkles; icon-color: #7c3aed; }
                                    Text { text: "LLM 润色"; color: #1f2937; font-size: 14px; font-weight: 700; vertical-alignment: center; }
                                    Text {
                                        text: "●";
                                        color: llm-enabled ? #22c55e : #9ca3af;
                                        font-size: 9px; vertical-alignment: center;
                                    }
                                    Rectangle { horizontal-stretch: 1; background: transparent; }
                                    Rectangle {
                                        width: 36px; height: 20px; border-radius: 10px;
                                        background: llm-enabled ? #7c3aed : #d1d5db;
                                        compact-llm-toggle-ta := TouchArea {
                                            clicked => { root.toggle-rewrite-requested(); }
                                        }
                                        Rectangle {
                                            width: 16px; height: 16px; border-radius: 8px;
                                            background: #ffffff;
                                            x: llm-enabled ? 18px : 2px; y: 2px;
                                        }
                                    }
                                }
                                VerticalLayout {
                                    spacing: 3px;
                                    Text {
                                        text: llm-provider-summary == "" ? "模型未配置" : llm-provider-summary;
                                        color: llm-enabled
                                            ? (llm-provider-summary == "" ? #dc2626 : #1f2937)
                                            : #9ca3af;
                                        font-size: 17px; font-weight: 700;
                                    }
                                    Text {
                                        text: llm-enabled ? "大模型对转录文本进行智能润色改写" : "润色功能已关闭，将直接输出语音输入结果";
                                        color: #667085; font-size: 12px; wrap: word-wrap;
                                    }
                                }
                                VerticalLayout {
                                    spacing: 5px;
                                    Text {
                                        text: "润色风格";
                                        color: llm-enabled ? #9ca3af : #d1d5db;
                                        font-size: 11px;
                                    }
                                    HorizontalLayout {
                                        spacing: 5px; alignment: start;
                                        for chip-info2 in [
                                            {id: "default", label: "结构化"},
                                            {id: "light",   label: "轻度整理"},
                                            {id: "formal",  label: "书面化"},
                                            {id: "custom",  label: "自定义"}
                                        ]: Rectangle {
                                            property <bool> is-active2: llm-active-prompt-id == chip-info2.id;
                                            border-radius: 7px;
                                            background: is-active2 ? #7c3aed : (llm-enabled ? #f3f4f6 : #f9fafb);
                                            border-width: is-active2 ? 0px : 1px;
                                            border-color: #e5e7eb;
                                            height: 28px;
                                            chip-ta2 := TouchArea {
                                                enabled: llm-enabled;
                                                clicked => { root.set-active-prompt-requested(chip-info2.id); }
                                                mouse-cursor: pointer;
                                            }
                                            HorizontalLayout {
                                                padding-left: 9px; padding-right: 9px; alignment: center;
                                                Text {
                                                    text: chip-info2.label;
                                                    color: is-active2 ? #ffffff : (llm-enabled ? #374151 : #d1d5db);
                                                    font-size: 11px; font-weight: is-active2 ? 700 : 400;
                                                    vertical-alignment: center;
                                                }
                                            }
                                        }
                                    }
                                    Text {
                                        text: llm-active-prompt-id == "default" ? "归纳总结，结构化表达，善用编号条目"
                                            : (llm-active-prompt-id == "light" ? "最少干预，修正标点错误，忠实保留原意"
                                            : (llm-active-prompt-id == "formal" ? "适合邮件与文档，正式规范的书面风格"
                                            : "使用下方自定义提示词"));
                                        color: llm-enabled ? #9ca3af : #d1d5db;
                                        font-size: 10px;
                                    }
                                }
                                Rectangle {
                                    border-radius: 10px;
                                    background: compact-llm-goto-ta.has-hover ? #ede9fe : #f5f3ff;
                                    border-width: 1px; border-color: #ddd6fe;
                                    height: 40px;
                                    compact-llm-goto-ta := TouchArea {
                                        clicked => { root.open-llm-settings-requested(); }
                                        mouse-cursor: pointer;
                                    }
                                    Text {
                                        text: "配置 API 与提示词  →";
                                        color: #6d28d9; font-size: 13px; font-weight: 700;
                                        horizontal-alignment: center; vertical-alignment: center;
                                    }
                                }
                                Rectangle { vertical-stretch: 1; background: transparent; }
                                Text {
                                    text: "建议开启，可显著提升输入效率和准确性";
                                    color: #3b82f6; font-size: 11px; wrap: word-wrap;
                                    horizontal-alignment: center;
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}
