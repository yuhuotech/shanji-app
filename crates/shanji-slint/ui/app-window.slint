                        border-color: #d7dee8;

                        VerticalLayout {
                            padding: 18px;
                            spacing: 10px;
                            Text { text: "最近结果"; color: #1f2937; font-size: 15px; font-weight: 700; }
                            Text { text: status-text; color: #344054; wrap: word-wrap; font-size: 14px; }
                            Text { text: live-asr-text; color: #667085; wrap: word-wrap; font-size: 14px; }
                            Text { text: history-preview-text; color: #667085; wrap: word-wrap; font-size: 14px; }
                        }
                    }

                        Rectangle {
                        border-radius: 18px;
                        background: #ffffff;
                        border-width: 1px;
                        border-color: #d7dee8;

                        VerticalLayout {
                            padding: 18px;
                            spacing: 10px;
                            Text { text: "运行状态"; color: #1f2937; font-size: 15px; font-weight: 700; }
                            Text { text: history-stats-text; color: #344054; wrap: word-wrap; font-size: 14px; }
                            Text { text: settings-summary-text; color: #667085; wrap: word-wrap; font-size: 14px; }
                            Text { text: rewrite-text; color: #667085; font-size: 14px; }
                            Text { text: tray-summary-text; color: #667085; wrap: word-wrap; font-size: 14px; }
                        }
                        }
                    }
                }
            }
        }
    }
}
