import { Button, ScrollView } from "std-widgets.slint";

// ── Reusable: small coloured icon box used in card section headers ──────────
component SectionIcon inherits Rectangle {
    in property <string> label;
    in property <brush> icon-color;

    width: 22px;
    height: 22px;
    border-radius: 6px;
    background: icon-color;

    Text {
        text: label;
        color: #ffffff;
        font-size: 12px;
        font-weight: 700;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
}

// ── Reusable: shield badge used in permission rows ────────────────────────────
component ShieldBadge inherits Rectangle {
    in property <bool> ok: true;

    width: 28px;
    height: 28px;
    border-radius: 7px;
    background: ok ? #d1fae5 : #fee2e2;

    Text {
        text: ok ? "✓" : "✗";
        color: ok ? #059669 : #dc2626;
        font-size: 13px;
        font-weight: 700;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
}

// ── Reusable: ghost icon button (SVG path) ───────────────────────────────────
component GhostIconButton inherits Rectangle {
    in property <string> icon-path;
    callback clicked;

    width: 34px;
    height: 30px;
    border-radius: 8px;
    border-width: 1px;
    border-color: #d0d8e4;
    background: ta.has-hover ? #f0f4f8 : #ffffff;

    ta := TouchArea { clicked => { root.clicked(); } }

    Path {
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        width: 16px;
        height: 16px;
        viewbox-width: 24;
        viewbox-height: 24;
        commands: root.icon-path;
        stroke: #4b5563;
        stroke-width: 1.8px;
        fill: transparent;
    }
}

// ── Reusable: info pill (版本 / 大小 / 语言) ─────────────────────────────────
component InfoPill inherits Rectangle {
    in property <string> label;
    in property <string> value;

    border-radius: 10px;
    background: #f2f4f7;
    horizontal-stretch: 1;

    VerticalLayout {
        alignment: center;
        padding-top: 8px; padding-bottom: 8px;
        padding-left: 6px; padding-right: 6px;
        spacing: 2px;
        Text { text: label; color: #667085; font-size: 11px; horizontal-alignment: center; }
        Text { text: value; color: #1f2937; font-size: 13px; font-weight: 700; horizontal-alignment: center; }
    }
}

export component AppWindow inherits Window {
    // ── properties ──────────────────────────────────────────────────────────
    in-out property <string> app-name: "闪记";
    in-out property <string> app-subtitle-text: "AI 语音输入工具";
    in-out property <string> status-text: "准备就绪";
    in-out property <string> hotkey-hint-title: "按下快捷键开始语音输入";
    in-out property <string> hotkey-hint-body: "把光标放到目标输入框，按住说话，松开后自动转写并粘贴";
    in-out property <string> hotkey-display-text: "LeftCommand";

    in-out property <string> model-title-text: "Paraformer 中文";
    in-out property <string> model-desc-text: "中文普通话语音识别";
    in-out property <string> model-version-text: "v1.0.0";
    in-out property <string> model-size-text: "0 MB";
    in-out property <string> model-language-text: "ZH";
    in-out property <string> model-install-text: "模型已安装";
    in-out property <bool>   model-ready: true;
    in-out property <bool>   model-downloading: false;
    in-out property <float>  model-download-progress: 0.0;
    in-out property <string> model-download-status-text: "";
    in-out property <string> model-download-error-text: "";

    callback download-model-requested();

    in-out property <string> mic-permission-title: "麦克风权限已获取";
    in-out property <string> mic-permission-body: "已检测到 1 个可用输入设备";
    in-out property <bool>   mic-ready: true;
    in-out property <string> paste-permission-title: "自动粘贴已授权";
    in-out property <string> paste-permission-body: "已授权，可将识别结果自动粘贴到当前输入位置";
    in-out property <bool>   paste-ready: true;
    in-out property <string> default-device-text: "MacBook Pro麦克风";

    in-out property <string> transcribe-card-title: "语音转写测试";
    in-out property <string> transcribe-button-text: "点击测试录音";
    in-out property <string> transcribe-body-text: "测试转写功能是否正常";
    in-out property <string> audio-level-text: "0%";
    in-out property <float>  audio-level-value: 0.0;
    in-out property <string> monitor-button-text: "监听麦克风输入";
    in-out property <string> monitor-tip-text: "提示：日常使用无需打开此窗口，直接按快捷键即可";

    // kept for Rust binding compatibility
    in-out property <string> history-stats-text: "";
    in-out property <string> history-preview-text: "";
    in-out property <string> settings-summary-text: "";
    in-out property <string> rewrite-text: "";
    in-out property <string> tray-summary-text: "";
    in-out property <string> live-asr-text: "";

    // Equal column width: (inner_content_width - 2*spacing) / 3
    // inner = VerticalLayout.width(= min(max(W-40,360),1180)) - 2*padding(20px) = VW - 40
    // card-col-width = (VW - 40 - 28) / 3
    property <length> card-col-width:
        (min(max(root.width - 40px, 360px), 1180px) - 68px) / 3;

    callback refresh-requested();
    callback open-history-requested();
    callback open-settings-requested();
    callback toggle-live-asr-requested();
    callback toggle-mic-monitor-requested();
    callback request-mic-permission();

    title: app-name;
    width: 960px;
    height: 640px;
    default-font-family: "Hiragino Sans GB";
    in property <bool> compact-layout: root.width < 860px;

    Rectangle {
        background: #edf1f6;

        ScrollView {
            width: parent.width;
            height: parent.height;

            content := Rectangle {
                width: root.width;
                background: transparent;

                VerticalLayout {
                    x: max((parent.width - self.width) / 2, 0px);
                    width: min(max(root.width - 40px, 360px), 1180px);
                    padding: 20px;
                    spacing: 14px;

                    // ════════════════════════════════════════════════════════
                    // Header — flat, blends into window background
                    // ════════════════════════════════════════════════════════
                    HorizontalLayout {
                        padding-top: 2px;
                        padding-bottom: 4px;
                        padding-left: 4px;
                        padding-right: 0px;
                        spacing: 10px;

                        Rectangle {
                            width: 42px; height: 42px;
                            border-radius: 12px;
                            background: #2962ff;

                            Path {
                                x: (parent.width - self.width) / 2;
                                y: (parent.height - self.height) / 2;
                                width: 22px; height: 22px;
                                viewbox-width: 24; viewbox-height: 24;
                                // mic body + stand arc + pole + base
                                commands: "M 9 12 L 9 5 A 3 3 0 0 1 15 5 L 15 12 A 3 3 0 0 1 9 12 Z M 5 11 A 7 7 0 0 0 19 11 M 12 18 L 12 21 M 9 21 L 15 21";
                                stroke: #ffffff;
                                stroke-width: 1.5px;
                                fill: transparent;
                            }
                        }

                        VerticalLayout {
                            alignment: center;
                            spacing: 2px;
                            Text { text: app-name;          color: #1a2740; font-size: 16px; font-weight: 700; }
                            Text { text: app-subtitle-text;  color: #374151; font-size: 11px; }
                        }

                        Rectangle { horizontal-stretch: 1; background: transparent; }

                        HorizontalLayout {
                            alignment: end;
                            spacing: 4px;
                            // 刷新：循环箭头 (Feather refresh-cw)
                            GhostIconButton {
                                icon-path: "M 23 4 L 23 10 L 17 10 M 1 20 L 1 14 L 7 14 M 3.51 9 A 9 9 0 0 1 18.36 5.64 L 23 10 M 1 14 L 5.64 18.36 A 9 9 0 0 0 20.49 15";
                                clicked => { root.refresh-requested(); }
                            }
                            // 历史：时钟 (Feather clock)
                            GhostIconButton {
                                icon-path: "M 12 2 A 10 10 0 1 0 12 22 A 10 10 0 0 0 12 2 Z M 12 6 L 12 12 L 16 14";
                                clicked => { root.open-history-requested(); }
                            }
                            // 设置：滑块调节 (Feather sliders)
                            GhostIconButton {
                                icon-path: "M 4 21 L 4 14 M 4 10 L 4 3 M 12 21 L 12 12 M 12 8 L 12 3 M 20 21 L 20 16 M 20 12 L 20 3 M 1 14 L 7 14 M 9 8 L 15 8 M 17 16 L 23 16";
                                clicked => { root.open-settings-requested(); }
                            }
                        }
                    }

                    // ════════════════════════════════════════════════════════
                    // Hotkey banner
                    // ════════════════════════════════════════════════════════
                    Rectangle {
                        border-radius: 18px;
                        background: #e8f3ff;
                        border-width: 1px;
                        border-color: #b9d8ff;

                        HorizontalLayout {
                            padding: 16px;
                            spacing: 14px;

                            Rectangle {
                                width: 46px; height: 46px;
                                border-radius: 13px;
                                background: #2962ff;
                                Text { text: "⌨"; color: #ffffff; horizontal-alignment: center; vertical-alignment: center; font-size: 22px; font-weight: 700; }
                            }

                            VerticalLayout {
                                alignment: center;
                                spacing: 5px;
                                Text { text: hotkey-hint-title; color: #2563eb; font-size: 15px; font-weight: 700; }
                                Text { text: hotkey-hint-body;  color: #475467; font-size: 13px; wrap: word-wrap; }
                            }

                            Rectangle { horizontal-stretch: 1; background: transparent; }

                            Rectangle {
                                border-radius: 10px;
                                background: #ffffff;
                                border-width: 1.5px;
                                border-color: #d0d5dd;

                                VerticalLayout {
                                    padding-top: 12px; padding-bottom: 12px;
                                    padding-left: 20px; padding-right: 20px;
                                    Text {
                                        text: hotkey-display-text;
                                        color: #1d2939;
                                        horizontal-alignment: center;
                                        font-size: 15px;
                                        font-weight: 700;
                                    }
                                }
                            }
                        }
                    }

                    // ════════════════════════════════════════════════════════
                    // Three status cards — wide layout
                    // ════════════════════════════════════════════════════════
                    if !root.compact-layout : HorizontalLayout {
                        spacing: 14px;

                        // ── 模型状态 ──────────────────────────────────────
                        Rectangle {
                            border-radius: 18px;
                            background: #ffffff;
                            border-width: 1px;
                            border-color: #d7dee8;
                            width: card-col-width;

                            VerticalLayout {
                                alignment: start;
                                padding: 18px;
                                spacing: 10px;

                                // title row
                                HorizontalLayout {
                                    spacing: 7px;
                                    SectionIcon { label: "↓"; icon-color: #0d9488; }
                                    Text { text: "模型状态"; color: #1f2937; font-size: 14px; font-weight: 700; vertical-alignment: center; }
                                    Text { text: "●"; color: model-ready ? #22c55e : #ef4444; font-size: 9px; vertical-alignment: center; }
                                    Rectangle { horizontal-stretch: 1; background: transparent; }
                                    if model-ready : Rectangle {
                                        border-radius: 6px;
                                        background: #d1fae5;
                                        border-width: 1px;
                                        border-color: #6ee7b7;
                                        HorizontalLayout {
                                            padding-left: 8px; padding-right: 8px;
                                            padding-top: 3px; padding-bottom: 3px;
                                            Text { text: "已加载"; color: #065f46; font-size: 11px; font-weight: 700; vertical-alignment: center; }
                                        }
                                    }
                                    if model-downloading : Rectangle {
                                        border-radius: 6px;
                                        background: #eff6ff;
                                        border-width: 1px;
                                        border-color: #93c5fd;
                                        HorizontalLayout {
                                            padding-left: 8px; padding-right: 8px;
                                            padding-top: 3px; padding-bottom: 3px;
                                            Text { text: "下载中"; color: #1d4ed8; font-size: 11px; font-weight: 700; vertical-alignment: center; }
                                        }
                                    }
                                    if !model-ready && !model-downloading : Rectangle {
                                        border-radius: 6px;
                                        background: #fef3c7;
                                        border-width: 1px;
                                        border-color: #fcd34d;
                                        HorizontalLayout {
                                            padding-left: 8px; padding-right: 8px;
                                            padding-top: 3px; padding-bottom: 3px;
                                            Text { text: "未下载"; color: #92400e; font-size: 11px; font-weight: 700; vertical-alignment: center; }
                                        }
                                    }
                                }

                                // model name + description
                                VerticalLayout {
                                    spacing: 4px;
                                    Text { text: model-title-text; color: #1f2937; font-size: 17px; font-weight: 700; }
                                    Text { text: model-desc-text;  color: #667085; font-size: 12px; wrap: word-wrap; }
                                }

                                // version / size / language pills
                                HorizontalLayout {
                                    spacing: 8px;
                                    InfoPill { label: "版本"; value: model-version-text; }
                                    InfoPill { label: "大小"; value: model-size-text;    }
                                    InfoPill { label: "语言"; value: model-language-text; }
                                }

                                // install badge — installed
                                if model-ready : Rectangle {
                                    border-radius: 10px;
                                    background: #dff6e8;
                                    height: 40px;
                                    Text {
                                        text: "✓  模型已安装";
                                        color: #1a7f45;
                                        horizontal-alignment: center;
                                        vertical-alignment: center;
                                        font-size: 13px;
                                        font-weight: 700;
                                    }
                                }

                                // download progress bar
                                if model-downloading : VerticalLayout {
                                    spacing: 6px;
                                    padding-top: 4px;
                                    Text {
                                        text: model-download-status-text;
                                        color: #374151;
                                        font-size: 12px;
                                        horizontal-alignment: center;
                                    }
                                    Rectangle {
                                        height: 8px;
                                        border-radius: 4px;
                                        background: #e5e7eb;
                                        Rectangle {
                                            height: 8px;
                                            border-radius: 4px;
                                            background: #0d9488;
                                            x: 0;
                                            width: parent.width * root.model-download-progress;
                                        }
                                    }
                                }

                                // download button — not installed, not downloading
                                if !model-ready && !model-downloading : Rectangle {
                                    border-radius: 10px;
                                    background: dl-ta.has-hover ? #dbeafe : #eff6ff;
                                    border-width: 1px;
                                    border-color: #93c5fd;
                                    height: 40px;
                                    dl-ta := TouchArea { clicked => { root.download-model-requested(); } }
                                    Text {
                                        text: "↓  下载模型";
                                        color: #1d4ed8;
                                        horizontal-alignment: center;
                                        vertical-alignment: center;
                                        font-size: 13px;
                                        font-weight: 700;
                                    }
                                }

                                // error message after failed download
                                if !model-ready && !model-downloading && model-download-error-text != "" : Rectangle {
                                    border-radius: 8px;
                                    background: #fef2f2;
                                    border-width: 1px;
                                    border-color: #fecaca;
                                    VerticalLayout {
                                        padding: 8px;
                                        Text {
                                            text: "下载失败：" + model-download-error-text;
                                            color: #b91c1c;
                                            font-size: 11px;
                                            wrap: word-wrap;
                                        }
                                    }
                                }
                            }
                        }

                        // ── 麦克风授权 ────────────────────────────────────
                        Rectangle {
                            border-radius: 18px;
                            background: #ffffff;
                            border-width: 1px;
                            border-color: #d7dee8;
                            width: card-col-width;

                            VerticalLayout {
                                alignment: start;
                                padding: 18px;
                                spacing: 10px;

                                // title row
                                HorizontalLayout {
                                    spacing: 7px;
                                    height: 22px;
                                    SectionIcon { label: "~"; icon-color: #3b82f6; }
                                    Text { text: "麦克风授权"; color: #1f2937; font-size: 14px; font-weight: 700; vertical-alignment: center; }
                                    Text { text: "●"; color: mic-ready ? #22c55e : #ef4444; font-size: 9px; vertical-alignment: center; }
                                    Rectangle { horizontal-stretch: 1; background: transparent; }
                                }

                                // mic permission
                                HorizontalLayout {
                                    spacing: 10px;
                                    alignment: start;
                                    ShieldBadge { ok: mic-ready; }
                                    VerticalLayout {
                                        spacing: 3px;
                                        horizontal-stretch: 1;
                                        Text { text: mic-permission-title; color: mic-ready ? #1f2937 : #dc2626; font-size: 13px; font-weight: 700; }
                                        Text { text: mic-permission-body;  color: #667085; font-size: 12px; wrap: word-wrap; }
                                        if !mic-ready: Rectangle {
                                            height: 28px;
                                            border-radius: 6px;
                                            background: mic-auth-ta.has-hover ? #1d4ed8 : #2563eb;
                                            width: 120px;
                                            mic-auth-ta := TouchArea {
                                                clicked => { root.request-mic-permission(); }
                                            }
                                            Text {
                                                text: "前往系统设置授权";
                                                color: #ffffff;
                                                font-size: 11px;
                                                font-weight: 700;
                                                horizontal-alignment: center;
                                                vertical-alignment: center;
                                            }
                                        }
                                    }
                                }

                                // paste permission
                                HorizontalLayout {
                                    spacing: 10px;
                                    alignment: start;
                                    ShieldBadge { ok: paste-ready; }
                                    VerticalLayout {
                                        spacing: 3px;
                                        horizontal-stretch: 1;
                                        Text { text: paste-permission-title; color: #1f2937; font-size: 13px; font-weight: 700; }
                                        Text { text: paste-permission-body;  color: #667085; font-size: 12px; wrap: word-wrap; }
                                    }
                                }

                                // default device
                                VerticalLayout {
                                    spacing: 3px;
                                    Text { text: "默认设备";       color: #9ca3af; font-size: 11px; }
                                    Text { text: default-device-text; color: #1f2937; font-size: 15px; font-weight: 700; }
                                }
                            }
                        }

                        // ── 语音转写测试 ──────────────────────────────────
                        Rectangle {
                            border-radius: 18px;
                            background: #ffffff;
                            border-width: 1px;
                            border-color: #d7dee8;
                            width: card-col-width;

                            VerticalLayout {
                                alignment: start;
                                padding: 18px;
                                spacing: 10px;

                                // title row
                                HorizontalLayout {
                                    spacing: 7px;
                                    height: 22px;
                                    SectionIcon { label: "♪"; icon-color: #8b5cf6; }
                                    Text { text: transcribe-card-title; color: #1f2937; font-size: 14px; font-weight: 700; vertical-alignment: center; }
                                    Rectangle { horizontal-stretch: 1; background: transparent; }
                                }

                                // mic button row
                                HorizontalLayout {
                                    spacing: 14px;
                                    alignment: center;

                                    Rectangle {
                                        width: 62px; height: 62px;
                                        border-radius: 16px;
                                        background: #2962ff;

                                        TouchArea { clicked => { root.toggle-live-asr-requested(); } }
                                        Text { text: "🎤"; horizontal-alignment: center; vertical-alignment: center; font-size: 26px; }
                                    }

                                    VerticalLayout {
                                        alignment: center;
                                        spacing: 4px;
                                        Text { text: transcribe-button-text; color: #1f2937; font-size: 16px; font-weight: 700; }
                                        Text { text: transcribe-body-text;   color: #667085; font-size: 12px; wrap: word-wrap; }
                                    }
                                }

                                // volume bar
                                VerticalLayout {
                                    spacing: 6px;
                                    HorizontalLayout {
                                        Text { text: "输入音量"; color: #9ca3af; font-size: 12px; horizontal-stretch: 1; }
                                        Text { text: audio-level-text; color: #9ca3af; font-size: 12px; }
                                    }
                                    Rectangle {
                                        height: 6px;
                                        border-radius: 3px;
                                        background: #e5e7eb;
                                        Rectangle {
                                            height: 6px;
                                            border-radius: 3px;
                                            background: #3b82f6;
                                            width: parent.width * root.audio-level-value;
                                        }
                                    }
                                }

                                // monitor button
                                Button {
                                    text: monitor-button-text;
                                    clicked => { root.toggle-mic-monitor-requested(); }
                                }

                                // tip box
                                Rectangle {
                                    border-radius: 10px;
                                    background: #fff7e8;
                                    VerticalLayout {
                                        padding: 12px;
                                        Text {
                                            text: monitor-tip-text;
                                            color: #c26b16;
                                            wrap: word-wrap;
                                            font-size: 12px;
                                            font-weight: 600;
                                        }
                                    }
                                }
                            }
                        }
                    }

                    // ════════════════════════════════════════════════════════
                    // Tips row (wide layout only)
                    // ════════════════════════════════════════════════════════
                    if !root.compact-layout : HorizontalLayout {
                        spacing: 14px;

                        Rectangle {
                            border-radius: 14px; background: #f0fdf4;
                            border-width: 1px; border-color: #bbf7d0;
                            width: card-col-width;
                            VerticalLayout {
                                alignment: start; padding: 14px; spacing: 6px;
                                HorizontalLayout {
                                    spacing: 6px;
                                    SectionIcon { label: "✓"; icon-color: #16a34a; }
                                    Text { text: "本地离线识别"; color: #15803d; font-size: 13px; font-weight: 700; vertical-alignment: center; }
                                }
                                Text {
                                    text: "音频在本机处理，不上传任何语音数据，隐私完全可控";
                                    color: #4b7c5c; font-size: 12px; wrap: word-wrap;
                                }
                            }
                        }

                        Rectangle {
                            border-radius: 14px; background: #eff6ff;
                            border-width: 1px; border-color: #bfdbfe;
                            width: card-col-width;
                            VerticalLayout {
                                alignment: start; padding: 14px; spacing: 6px;
                                HorizontalLayout {
                                    spacing: 6px;
                                    SectionIcon { label: "↩"; icon-color: #2563eb; }
                                    Text { text: "全自动粘贴"; color: #1d4ed8; font-size: 13px; font-weight: 700; vertical-alignment: center; }
                                }
                                Text {
                                    text: "松开快捷键后，转写结果自动写入当前焦点输入框，无需手动复制";
                                    color: #3b5ea6; font-size: 12px; wrap: word-wrap;
                                }
                            }
                        }

                        Rectangle {
                            border-radius: 14px; background: #faf5ff;
                            border-width: 1px; border-color: #e9d5ff;
                            width: card-col-width;
                            VerticalLayout {
                                alignment: start; padding: 14px; spacing: 6px;
                                HorizontalLayout {
                                    spacing: 6px;
                                    SectionIcon { label: "✎"; icon-color: #7c3aed; }
                                    Text { text: "智能改写"; color: #6d28d9; font-size: 13px; font-weight: 700; vertical-alignment: center; }
                                }
                                Text {
                                    text: "可在设置中开启 LLM 改写，对转写结果润色、纠错、调整风格";
                                    color: #5b3e8e; font-size: 12px; wrap: word-wrap;
                                }
                            }
                        }
                    }

                    // ════════════════════════════════════════════════════════
                    // Three status cards — compact (stacked) layout
                    // ════════════════════════════════════════════════════════
                    if root.compact-layout : VerticalLayout {
                        spacing: 14px;

                        // 模型状态
                        Rectangle {
                            border-radius: 18px; background: #ffffff;
                            border-width: 1px; border-color: #d7dee8;                            VerticalLayout {
                                alignment: start; padding: 18px; spacing: 10px;
                                HorizontalLayout {
                                    spacing: 7px;
                                    SectionIcon { label: "↓"; icon-color: #0d9488; }
                                    Text { text: "模型状态"; color: #1f2937; font-size: 14px; font-weight: 700; vertical-alignment: center; }
                                    Text { text: "●"; color: model-ready ? #22c55e : #ef4444; font-size: 9px; vertical-alignment: center; }
                                    Rectangle { horizontal-stretch: 1; background: transparent; }
                                    if model-ready : Rectangle {
                                        border-radius: 6px;
                                        background: #d1fae5;
                                        border-width: 1px;
                                        border-color: #6ee7b7;
                                        HorizontalLayout {
                                            padding-left: 8px; padding-right: 8px;
                                            padding-top: 3px; padding-bottom: 3px;
                                            Text { text: "已加载"; color: #065f46; font-size: 11px; font-weight: 700; vertical-alignment: center; }
                                        }
                                    }
                                    if model-downloading : Rectangle {
                                        border-radius: 6px;
                                        background: #eff6ff;
                                        border-width: 1px;
                                        border-color: #93c5fd;
                                        HorizontalLayout {
                                            padding-left: 8px; padding-right: 8px;
                                            padding-top: 3px; padding-bottom: 3px;
                                            Text { text: "下载中"; color: #1d4ed8; font-size: 11px; font-weight: 700; vertical-alignment: center; }
                                        }
                                    }
                                    if !model-ready && !model-downloading : Rectangle {
                                        border-radius: 6px;
                                        background: #fef3c7;
                                        border-width: 1px;
                                        border-color: #fcd34d;
                                        HorizontalLayout {
                                            padding-left: 8px; padding-right: 8px;
                                            padding-top: 3px; padding-bottom: 3px;
                                            Text { text: "未下载"; color: #92400e; font-size: 11px; font-weight: 700; vertical-alignment: center; }
                                        }
                                    }
                                }
                                VerticalLayout {
                                    spacing: 4px;
                                    Text { text: model-title-text; color: #1f2937; font-size: 17px; font-weight: 700; }
                                    Text { text: model-desc-text;  color: #667085; font-size: 12px; wrap: word-wrap; }
                                }
                                HorizontalLayout {
                                    spacing: 8px;
                                    InfoPill { label: "版本"; value: model-version-text; }
                                    InfoPill { label: "大小"; value: model-size-text;    }
                                    InfoPill { label: "语言"; value: model-language-text; }
                                }
                                if model-ready : Rectangle {
                                    border-radius: 10px; background: #dff6e8; height: 40px;
                                    Text {
                                        text: "✓  模型已安装";
                                        color: #1a7f45;
                                        horizontal-alignment: center; vertical-alignment: center;
                                        font-size: 13px; font-weight: 700;
                                    }
                                }
                                if model-downloading : VerticalLayout {
                                    spacing: 6px; padding-top: 4px;
                                    Text { text: model-download-status-text; color: #374151; font-size: 12px; horizontal-alignment: center; }
                                    Rectangle {
                                        height: 8px; border-radius: 4px; background: #e5e7eb;
                                        Rectangle { height: 8px; border-radius: 4px; background: #0d9488; width: parent.width * root.model-download-progress; }
                                    }
                                }
                                if !model-ready && !model-downloading : Rectangle {
                                    border-radius: 10px;
                                    background: cdl-ta.has-hover ? #dbeafe : #eff6ff;
                                    border-width: 1px; border-color: #93c5fd; height: 40px;
                                    cdl-ta := TouchArea { clicked => { root.download-model-requested(); } }
                                    Text {
                                        text: "↓  下载模型"; color: #1d4ed8;
                                        horizontal-alignment: center; vertical-alignment: center;
                                        font-size: 13px; font-weight: 700;
                                    }
                                }
                                if !model-ready && !model-downloading && model-download-error-text != "" : Rectangle {
                                    border-radius: 8px; background: #fef2f2;
                                    border-width: 1px; border-color: #fecaca;
                                    VerticalLayout {
                                        padding: 8px;
                                        Text {
                                            text: "下载失败：" + model-download-error-text;
                                            color: #b91c1c; font-size: 11px; wrap: word-wrap;
                                        }
                                    }
                                }
                            }
                        }

                        // 麦克风授权
                        Rectangle {
                            border-radius: 18px; background: #ffffff;
                            border-width: 1px; border-color: #d7dee8;                            VerticalLayout {
                                alignment: start; padding: 18px; spacing: 10px;
                                HorizontalLayout {
                                    spacing: 7px; height: 22px;
                                    SectionIcon { label: "~"; icon-color: #3b82f6; }
                                    Text { text: "麦克风授权"; color: #1f2937; font-size: 14px; font-weight: 700; vertical-alignment: center; }
                                    Text { text: "●"; color: mic-ready ? #22c55e : #ef4444; font-size: 9px; vertical-alignment: center; }
                                    Rectangle { horizontal-stretch: 1; background: transparent; }
                                }
                                HorizontalLayout {
                                    spacing: 10px; alignment: start;
                                    ShieldBadge { ok: mic-ready; }
                                    VerticalLayout {
                                        spacing: 3px; horizontal-stretch: 1;
                                        Text { text: mic-permission-title; color: mic-ready ? #1f2937 : #dc2626; font-size: 13px; font-weight: 700; }
                                        Text { text: mic-permission-body;  color: #667085; font-size: 12px; wrap: word-wrap; }
                                        if !mic-ready: Rectangle {
                                            height: 28px;
                                            border-radius: 6px;
                                            background: mic-auth-ta2.has-hover ? #1d4ed8 : #2563eb;
                                            width: 120px;
                                            mic-auth-ta2 := TouchArea {
                                                clicked => { root.request-mic-permission(); }
                                            }
                                            Text {
                                                text: "前往系统设置授权";
                                                color: #ffffff;
                                                font-size: 11px;
                                                font-weight: 700;
                                                horizontal-alignment: center;
                                                vertical-alignment: center;
                                            }
                                        }
                                    }
                                }
                                HorizontalLayout {
                                    spacing: 10px; alignment: start;
                                    ShieldBadge { ok: paste-ready; }
                                    VerticalLayout {
                                        spacing: 3px; horizontal-stretch: 1;
                                        Text { text: paste-permission-title; color: #1f2937; font-size: 13px; font-weight: 700; }
                                        Text { text: paste-permission-body;  color: #667085; font-size: 12px; wrap: word-wrap; }
                                    }
                                }
                                VerticalLayout {
                                    spacing: 3px;
                                    Text { text: "默认设备";       color: #9ca3af; font-size: 11px; }
                                    Text { text: default-device-text; color: #1f2937; font-size: 15px; font-weight: 700; }
                                }
                            }
                        }

                        // 语音转写测试
                        Rectangle {
                            border-radius: 18px; background: #ffffff;
                            border-width: 1px; border-color: #d7dee8;
                            VerticalLayout {
                                alignment: start; padding: 18px; spacing: 10px;
                                HorizontalLayout {
                                    spacing: 7px; height: 22px;
                                    SectionIcon { label: "♪"; icon-color: #8b5cf6; }
                                    Text { text: transcribe-card-title; color: #1f2937; font-size: 14px; font-weight: 700; vertical-alignment: center; }
                                    Rectangle { horizontal-stretch: 1; background: transparent; }
                                }
                                HorizontalLayout {
                                    spacing: 14px; alignment: center;
                                    Rectangle {
                                        width: 62px; height: 62px; border-radius: 16px; background: #2962ff;
                                        TouchArea { clicked => { root.toggle-live-asr-requested(); } }
                                        Text { text: "🎤"; horizontal-alignment: center; vertical-alignment: center; font-size: 26px; }
                                    }
                                    VerticalLayout {
                                        alignment: center;
                                        spacing: 4px;
                                        Text { text: transcribe-button-text; color: #1f2937; font-size: 16px; font-weight: 700; }
                                        Text { text: transcribe-body-text;   color: #667085; font-size: 12px; wrap: word-wrap; }
                                    }
                                }
                                VerticalLayout {
                                    spacing: 6px;
                                    HorizontalLayout {
                                        Text { text: "输入音量"; color: #9ca3af; font-size: 12px; horizontal-stretch: 1; }
                                        Text { text: audio-level-text; color: #9ca3af; font-size: 12px; }
                                    }
                                    Rectangle {
                                        height: 6px; border-radius: 3px; background: #e5e7eb;
                                        Rectangle { height: 6px; border-radius: 3px; background: #3b82f6; width: parent.width * root.audio-level-value; }
                                    }
                                }
                                Button { text: monitor-button-text; clicked => { root.toggle-mic-monitor-requested(); } }
                                Rectangle {
                                    border-radius: 10px; background: #fff7e8;
                                    VerticalLayout {
                                        padding: 12px;
                                        Text { text: monitor-tip-text; color: #c26b16; wrap: word-wrap; font-size: 12px; font-weight: 600; }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}
