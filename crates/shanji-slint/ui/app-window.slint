                                    Text { text: refine-model-desc-text;  color: #667085; font-size: 12px; wrap: word-wrap; }
                                }
                                HorizontalLayout {
                                    spacing: 8px;
                                    InfoPill { label: "版本"; value: refine-model-version-text; }
                                    InfoPill { label: "大小"; value: refine-model-size-text;    }
                                    InfoPill { label: "语言"; value: refine-model-language-text; }
                                }
                                if refine-model-downloaded : HorizontalLayout {
                                    spacing: 10px;
                                    Text {
                                        text: "纠正功能"; color: #374151;
                                        font-size: 13px; font-weight: 600;
                                        vertical-alignment: center; horizontal-stretch: 1;
                                    }
                                    Rectangle {
                                        width: 44px; height: 24px; border-radius: 12px;
                                        background: refine-asr-enabled ? #22c55e : #d1d5db;
                                        compact-refine-toggle-ta := TouchArea {
                                            clicked => { root.toggle-refine-asr-requested(); }
                                        }
                                        Rectangle {
                                            width: 20px; height: 20px; border-radius: 10px;
                                            background: #ffffff;
                                            x: refine-asr-enabled ? 22px : 2px; y: 2px;
                                        }
                                    }
                                }
                                if refine-model-downloaded && refine-asr-enabled : Rectangle {
                                    border-radius: 10px; background: #dff6e8; height: 40px;
                                    Text {
                                        text: "✓  纠正已启用"; color: #1a7f45;
                                        horizontal-alignment: center; vertical-alignment: center;
                                        font-size: 13px; font-weight: 700;
                                    }
                                }
                                if refine-model-downloaded && !refine-asr-enabled : Rectangle {
                                    border-radius: 10px; background: #f3f4f6;
                                    border-width: 1px; border-color: #e5e7eb; height: 40px;
                                    Text {
                                        text: "—  纠正已停用"; color: #6b7280;
                                        horizontal-alignment: center; vertical-alignment: center;
                                        font-size: 13px; font-weight: 700;
                                    }
                                }
                                if refine-model-downloading : VerticalLayout {
                                    spacing: 6px; padding-top: 4px;
                                    Text { text: refine-model-download-status-text; color: #374151; font-size: 12px; horizontal-alignment: center; }
                                    Rectangle {
                                        height: 8px; border-radius: 4px; background: #e5e7eb;
                                        Rectangle { height: 8px; border-radius: 4px; background: #f59e0b; x: 0; width: parent.width * root.refine-model-download-progress; }
                                    }
                                }
                                if !refine-model-downloaded && !refine-model-downloading : Rectangle {
                                    border-radius: 10px;
                                    background: crdl-ta.has-hover ? #dbeafe : #eff6ff;
                                    border-width: 1px; border-color: #93c5fd; height: 40px;
                                    crdl-ta := TouchArea { clicked => { root.download-refine-model-requested(); } }
                                    Text {
                                        text: "↓  下载模型"; color: #1d4ed8;
                                        horizontal-alignment: center; vertical-alignment: center;
                                        font-size: 13px; font-weight: 700;
                                    }
                                }
                                if !refine-model-downloaded && !refine-model-downloading && refine-model-download-error-text != "" : Rectangle {
                                    border-radius: 8px; background: #fef2f2;
                                    border-width: 1px; border-color: #fecaca;
                                    VerticalLayout {
                                        padding: 8px;
                                        Text { text: "下载失败：" + refine-model-download-error-text; color: #b91c1c; font-size: 11px; wrap: word-wrap; }
                                    }
                                }
                            }
                        }

                        // 麦克风授权
                        Rectangle {
                            border-radius: 18px; background: #ffffff;
                            border-width: 1px; border-color: #d7dee8;
                            VerticalLayout {
                                alignment: start; padding: 18px; spacing: 10px;
                                HorizontalLayout {
                                    spacing: 7px; height: 22px;
                                    SectionIcon { label: "~"; icon-color: #3b82f6; }
                                    Text { text: "麦克风授权"; color: #1f2937; font-size: 14px; font-weight: 700; vertical-alignment: center; }
                                    Text { text: "●"; color: mic-ready ? #22c55e : #ef4444; font-size: 9px; vertical-alignment: center; }
                                    Rectangle { horizontal-stretch: 1; background: transparent; }
                                }
                                HorizontalLayout {
                                    spacing: 10px; alignment: start;
                                    ShieldBadge { ok: mic-ready; }
                                    VerticalLayout {
                                        spacing: 3px; horizontal-stretch: 1;
                                        Text { text: mic-permission-title; color: mic-ready ? #1f2937 : #dc2626; font-size: 13px; font-weight: 700; }
                                        Text { text: mic-permission-body;  color: #667085; font-size: 12px; wrap: word-wrap; }
                                        if !mic-ready: Rectangle {
                                            height: 28px; border-radius: 6px;
                                            background: mic-auth-ta2.has-hover ? #1d4ed8 : #2563eb;
                                            width: 120px;
                                            mic-auth-ta2 := TouchArea { clicked => { root.request-mic-permission(); } }
                                            Text {
                                                text: "前往系统设置授权"; color: #ffffff;
                                                font-size: 11px; font-weight: 700;
                                                horizontal-alignment: center; vertical-alignment: center;
                                            }
                                        }
                                    }
                                }
                                HorizontalLayout {
                                    spacing: 10px; alignment: start;
                                    ShieldBadge { ok: paste-ready; }
                                    VerticalLayout {
                                        spacing: 3px; horizontal-stretch: 1;
                                        Text { text: paste-permission-title; color: #1f2937; font-size: 13px; font-weight: 700; }
                                        Text { text: paste-permission-body;  color: #667085; font-size: 12px; wrap: word-wrap; }
                                    }
                                }
                                VerticalLayout {
                                    spacing: 3px;
                                    Text { text: "默认设备"; color: #9ca3af; font-size: 11px; }
                                    Text { text: default-device-text; color: #1f2937; font-size: 15px; font-weight: 700; }
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}
