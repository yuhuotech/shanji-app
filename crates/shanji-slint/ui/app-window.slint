import { Button, ScrollView } from "std-widgets.slint";

// ── Reusable: small coloured icon box used in card section headers ──────────
component SectionIcon inherits Rectangle {
    in property <string> label;
    in property <brush> icon-color;

    width: 22px;
    height: 22px;
    border-radius: 6px;
    background: icon-color;

    Text {
        text: label;
        color: #ffffff;
        font-size: 12px;
        font-weight: 700;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
}

// ── Reusable: green shield badge used in permission rows ─────────────────────
component ShieldBadge inherits Rectangle {
    width: 28px;
    height: 28px;
    border-radius: 7px;
    background: #d1fae5;

    Text {
        text: "✓";
        color: #059669;
        font-size: 13px;
        font-weight: 700;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
}

// ── Reusable: info pill (版本 / 大小 / 语言) ─────────────────────────────────
component InfoPill inherits Rectangle {
    in property <string> label;
    in property <string> value;

    border-radius: 10px;
    background: #f2f4f7;
    horizontal-stretch: 1;

    VerticalLayout {
        alignment: center;
        padding-top: 8px; padding-bottom: 8px;
        padding-left: 6px; padding-right: 6px;
        spacing: 2px;
        Text { text: label; color: #667085; font-size: 11px; horizontal-alignment: center; }
        Text { text: value; color: #1f2937; font-size: 13px; font-weight: 700; horizontal-alignment: center; }
    }
}

export component AppWindow inherits Window {
    // ── properties ──────────────────────────────────────────────────────────
    in-out property <string> app-name: "闪记";
    in-out property <string> app-subtitle-text: "AI 语音输入工具";
    in-out property <string> status-text: "准备就绪";
    in-out property <string> hotkey-hint-title: "按下快捷键开始语音输入";
    in-out property <string> hotkey-hint-body: "把光标放到目标输入框，按住说话，松开后自动转写并粘贴";
    in-out property <string> hotkey-display-text: "LeftCommand";

    in-out property <string> model-title-text: "Paraformer 中文";
    in-out property <string> model-desc-text: "中文普通话语音识别（量化版）";
    in-out property <string> model-version-text: "v1.0.0";
    in-out property <string> model-size-text: "0 MB";
    in-out property <string> model-language-text: "ZH";
    in-out property <string> model-install-text: "模型已安装";
    in-out property <bool>   model-ready: true;

    in-out property <string> mic-permission-title: "麦克风权限已获取";
    in-out property <string> mic-permission-body: "已检测到 1 个可用输入设备";
    in-out property <bool>   mic-ready: true;
    in-out property <string> paste-permission-title: "自动粘贴已授权";
    in-out property <string> paste-permission-body: "已授权，可将识别结果自动粘贴到当前输入位置";
    in-out property <bool>   paste-ready: true;
    in-out property <string> default-device-text: "MacBook Pro麦克风";

    in-out property <string> transcribe-card-title: "语音转写测试";
    in-out property <string> transcribe-button-text: "点击测试录音";
    in-out property <string> transcribe-body-text: "测试转写功能是否正常";
    in-out property <string> audio-level-text: "0%";
    in-out property <float>  audio-level-value: 0.0;
    in-out property <string> monitor-button-text: "监听麦克风输入";
    in-out property <string> monitor-tip-text: "提示：日常使用无需打开此窗口，直接按快捷键即可";

    // kept for Rust binding compatibility
    in-out property <string> history-stats-text: "";
    in-out property <string> history-preview-text: "";
    in-out property <string> settings-summary-text: "";
    in-out property <string> rewrite-text: "";
    in-out property <string> tray-summary-text: "";
    in-out property <string> live-asr-text: "";

    callback refresh-requested();
    callback open-history-requested();
    callback open-settings-requested();
    callback toggle-live-asr-requested();
    callback toggle-mic-monitor-requested();

    title: app-name;
    width: 1080px;
    height: 720px;
    default-font-family: "Hiragino Sans GB";
    in property <bool> compact-layout: root.width < 860px;

    Rectangle {
        background: #edf1f6;

        ScrollView {
            width: parent.width;
            height: parent.height;

            content := Rectangle {
                width: root.width;
                background: transparent;

                VerticalLayout {
                    x: max((parent.width - self.width) / 2, 0px);
                    width: min(max(root.width - 40px, 360px), 1180px);
                    padding: 20px;
                    spacing: 14px;

                    // ════════════════════════════════════════════════════════
                    // Header — flat, blends into window background
                    // ════════════════════════════════════════════════════════
                    HorizontalLayout {
                        padding-top: 4px;
                        padding-bottom: 8px;
                        padding-left: 4px;
                        padding-right: 4px;
                        spacing: 12px;

                        Rectangle {
                            width: 40px; height: 40px;
                            border-radius: 11px;
                            background: #2f80ed;
                            Text { text: "🎤"; horizontal-alignment: center; vertical-alignment: center; font-size: 20px; }
                        }

                        VerticalLayout {
                            alignment: center;
                            spacing: 1px;
                            Text { text: app-name;          color: #1f2937; font-size: 17px; font-weight: 700; }
                            Text { text: app-subtitle-text;  color: #8d99ae; font-size: 12px; }
                        }

                        Rectangle { horizontal-stretch: 1; background: transparent; }

                        HorizontalLayout {
                            alignment: center;
                            spacing: 6px;
                            Button { text: "刷新"; clicked => { root.refresh-requested();      } }
                            Button { text: "历史"; clicked => { root.open-history-requested();  } }
                            Button { text: "设置"; clicked => { root.open-settings-requested(); } }
                        }
                    }

                    // ════════════════════════════════════════════════════════
                    // Hotkey banner
                    // ════════════════════════════════════════════════════════
                    Rectangle {
                        border-radius: 18px;
                        background: #e8f3ff;
                        border-width: 1px;
                        border-color: #b9d8ff;

                        HorizontalLayout {
                            padding: 16px;
                            spacing: 14px;

                            Rectangle {
                                width: 46px; height: 46px;
                                border-radius: 13px;
                                background: #2962ff;
                                Text { text: "⌨"; color: #ffffff; horizontal-alignment: center; vertical-alignment: center; font-size: 22px; font-weight: 700; }
                            }

                            VerticalLayout {
                                alignment: center;
                                spacing: 5px;
                                Text { text: hotkey-hint-title; color: #2563eb; font-size: 15px; font-weight: 700; }
                                Text { text: hotkey-hint-body;  color: #475467; font-size: 13px; wrap: word-wrap; }
                            }

                            Rectangle { horizontal-stretch: 1; background: transparent; }

                            Rectangle {
                                border-radius: 10px;
                                background: #ffffff;
                                border-width: 1.5px;
                                border-color: #d0d5dd;

                                VerticalLayout {
                                    padding-top: 12px; padding-bottom: 12px;
                                    padding-left: 20px; padding-right: 20px;
                                    Text {
                                        text: hotkey-display-text;
                                        color: #1d2939;
                                        horizontal-alignment: center;
                                        font-size: 15px;
                                        font-weight: 700;
                                    }
                                }
                            }
                        }
                    }

                    // ════════════════════════════════════════════════════════
                    // Three status cards — wide layout
                    // ════════════════════════════════════════════════════════
                    if !root.compact-layout : HorizontalLayout {
                        spacing: 14px;

                        // ── 模型状态 ──────────────────────────────────────
                        Rectangle {
                            border-radius: 18px;
                            background: #ffffff;
                            border-width: 1px;
                            border-color: #d7dee8;
                            horizontal-stretch: 1;

                            VerticalLayout {
                                alignment: start;
                                padding: 18px;
                                spacing: 10px;

                                // title row
                                HorizontalLayout {
                                    spacing: 7px;
                                    height: 22px;
                                    SectionIcon { label: "↓"; icon-color: #0d9488; }
                                    Text { text: "模型状态"; color: #1f2937; font-size: 14px; font-weight: 700; vertical-alignment: center; }
                                    Text { text: "●"; color: model-ready ? #22c55e : #ef4444; font-size: 9px; vertical-alignment: center; }
                                    Rectangle { horizontal-stretch: 1; background: transparent; }
                                }

                                // model name + description
                                VerticalLayout {
                                    spacing: 4px;
                                    Text { text: model-title-text; color: #1f2937; font-size: 17px; font-weight: 700; }
                                    Text { text: model-desc-text;  color: #667085; font-size: 12px; wrap: word-wrap; }
                                }

                                // version / size / language pills
                                HorizontalLayout {
                                    spacing: 8px;
                                    InfoPill { label: "版本"; value: model-version-text; }
                                    InfoPill { label: "大小"; value: model-size-text;    }
                                    InfoPill { label: "语言"; value: model-language-text; }
                                }

                                // install badge
                                Rectangle {
                                    border-radius: 10px;
                                    background: model-ready ? #dff6e8 : #fee2e2;
                                    height: 40px;

                                    Text {
                                        text: (model-ready ? "✓  " : "✗  ") + model-install-text;
                                        color: model-ready ? #1a7f45 : #b42318;
                                        horizontal-alignment: center;
                                        vertical-alignment: center;
                                        font-size: 13px;
                                        font-weight: 700;
                                    }
                                }
                            }
                        }

                        // ── 麦克风授权 ────────────────────────────────────
                        Rectangle {
                            border-radius: 18px;
                            background: #ffffff;
                            border-width: 1px;
                            border-color: #d7dee8;
                            horizontal-stretch: 1;

                            VerticalLayout {
                                alignment: start;
                                padding: 18px;
                                spacing: 10px;

                                // title row
                                HorizontalLayout {
                                    spacing: 7px;
                                    height: 22px;
                                    SectionIcon { label: "~"; icon-color: #3b82f6; }
                                    Text { text: "麦克风授权"; color: #1f2937; font-size: 14px; font-weight: 700; vertical-alignment: center; }
                                    Text { text: "●"; color: mic-ready ? #22c55e : #ef4444; font-size: 9px; vertical-alignment: center; }
                                    Rectangle { horizontal-stretch: 1; background: transparent; }
                                }

                                // mic permission
                                HorizontalLayout {
                                    spacing: 10px;
                                    alignment: start;
                                    ShieldBadge {}
                                    VerticalLayout {
                                        spacing: 3px;
                                        horizontal-stretch: 1;
                                        Text { text: mic-permission-title; color: #1f2937; font-size: 13px; font-weight: 700; }
                                        Text { text: mic-permission-body;  color: #667085; font-size: 12px; wrap: word-wrap; }
                                    }
                                }

                                // paste permission
                                HorizontalLayout {
                                    spacing: 10px;
                                    alignment: start;
                                    ShieldBadge {}
                                    VerticalLayout {
                                        spacing: 3px;
                                        horizontal-stretch: 1;
                                        Text { text: paste-permission-title; color: #1f2937; font-size: 13px; font-weight: 700; }
                                        Text { text: paste-permission-body;  color: #667085; font-size: 12px; wrap: word-wrap; }
                                    }
                                }

                                // default device
                                VerticalLayout {
                                    spacing: 3px;
                                    Text { text: "默认设备";       color: #9ca3af; font-size: 11px; }
                                    Text { text: default-device-text; color: #1f2937; font-size: 15px; font-weight: 700; }
                                }
                            }
                        }

                        // ── 语音转写测试 ──────────────────────────────────
                        Rectangle {
                            border-radius: 18px;
                            background: #ffffff;
                            border-width: 1px;
                            border-color: #d7dee8;
                            horizontal-stretch: 1;

                            VerticalLayout {
                                alignment: start;
                                padding: 18px;
                                spacing: 10px;

                                // title row
                                HorizontalLayout {
                                    spacing: 7px;
                                    height: 22px;
                                    SectionIcon { label: "♪"; icon-color: #8b5cf6; }
                                    Text { text: transcribe-card-title; color: #1f2937; font-size: 14px; font-weight: 700; vertical-alignment: center; }
                                    Rectangle { horizontal-stretch: 1; background: transparent; }
                                }

                                // mic button row
                                HorizontalLayout {
                                    spacing: 14px;
                                    alignment: center;

                                    Rectangle {
                                        width: 62px; height: 62px;
                                        border-radius: 16px;
                                        background: #2962ff;

                                        TouchArea { clicked => { root.toggle-live-asr-requested(); } }
                                        Text { text: "🎤"; horizontal-alignment: center; vertical-alignment: center; font-size: 26px; }
                                    }

                                    VerticalLayout {
                                        alignment: center;
                                        spacing: 4px;
                                        Text { text: transcribe-button-text; color: #1f2937; font-size: 16px; font-weight: 700; }
                                        Text { text: transcribe-body-text;   color: #667085; font-size: 12px; wrap: word-wrap; }
                                    }
                                }

                                // volume bar
                                VerticalLayout {
                                    spacing: 6px;
                                    HorizontalLayout {
                                        Text { text: "输入音量"; color: #9ca3af; font-size: 12px; horizontal-stretch: 1; }
                                        Text { text: audio-level-text; color: #9ca3af; font-size: 12px; }
                                    }
                                    Rectangle {
                                        height: 6px;
                                        border-radius: 3px;
                                        background: #e5e7eb;
                                        Rectangle {
                                            height: 6px;
                                            border-radius: 3px;
                                            background: #3b82f6;
                                            width: parent.width * root.audio-level-value;
                                        }
                                    }
                                }

                                // monitor button
                                Button {
                                    text: monitor-button-text;
                                    clicked => { root.toggle-mic-monitor-requested(); }
                                }

                                // tip box
                                Rectangle {
                                    border-radius: 10px;
                                    background: #fff7e8;
                                    VerticalLayout {
                                        padding: 12px;
                                        Text {
                                            text: monitor-tip-text;
                                            color: #c26b16;
                                            wrap: word-wrap;
                                            font-size: 12px;
                                            font-weight: 600;
                                        }
                                    }
                                }
                            }
                        }
                    }

                    // ════════════════════════════════════════════════════════
                    // Three status cards — compact (stacked) layout
                    // ════════════════════════════════════════════════════════
                    if root.compact-layout : VerticalLayout {
                        spacing: 14px;

                        // 模型状态
                        Rectangle {
                            border-radius: 18px; background: #ffffff;
                            border-width: 1px; border-color: #d7dee8;
                            VerticalLayout {
                                alignment: start; padding: 18px; spacing: 10px;
                                HorizontalLayout {
                                    spacing: 7px; height: 22px;
                                    SectionIcon { label: "↓"; icon-color: #0d9488; }
                                    Text { text: "模型状态"; color: #1f2937; font-size: 14px; font-weight: 700; vertical-alignment: center; }
                                    Text { text: "●"; color: model-ready ? #22c55e : #ef4444; font-size: 9px; vertical-alignment: center; }
                                    Rectangle { horizontal-stretch: 1; background: transparent; }
                                }
                                VerticalLayout {
                                    spacing: 4px;
                                    Text { text: model-title-text; color: #1f2937; font-size: 17px; font-weight: 700; }
                                    Text { text: model-desc-text;  color: #667085; font-size: 12px; wrap: word-wrap; }
                                }
                                HorizontalLayout {
                                    spacing: 8px;
                                    InfoPill { label: "版本"; value: model-version-text; }
                                    InfoPill { label: "大小"; value: model-size-text;    }
                                    InfoPill { label: "语言"; value: model-language-text; }
                                }
                                Rectangle {
                                    border-radius: 10px;
                                    background: model-ready ? #dff6e8 : #fee2e2;
                                    height: 40px;
                                    Text {
                                        text: (model-ready ? "✓  " : "✗  ") + model-install-text;
                                        color: model-ready ? #1a7f45 : #b42318;
                                        horizontal-alignment: center; vertical-alignment: center;
                                        font-size: 13px; font-weight: 700;
                                    }
                                }
                            }
                        }

                        // 麦克风授权
                        Rectangle {
                            border-radius: 18px; background: #ffffff;
                            border-width: 1px; border-color: #d7dee8;
                            VerticalLayout {
                                alignment: start; padding: 18px; spacing: 10px;
                                HorizontalLayout {
                                    spacing: 7px; height: 22px;
                                    SectionIcon { label: "~"; icon-color: #3b82f6; }
                                    Text { text: "麦克风授权"; color: #1f2937; font-size: 14px; font-weight: 700; vertical-alignment: center; }
                                    Text { text: "●"; color: mic-ready ? #22c55e : #ef4444; font-size: 9px; vertical-alignment: center; }
                                    Rectangle { horizontal-stretch: 1; background: transparent; }
                                }
                                HorizontalLayout {
                                    spacing: 10px; alignment: start;
                                    ShieldBadge {}
                                    VerticalLayout {
                                        spacing: 3px; horizontal-stretch: 1;
                                        Text { text: mic-permission-title; color: #1f2937; font-size: 13px; font-weight: 700; }
                                        Text { text: mic-permission-body;  color: #667085; font-size: 12px; wrap: word-wrap; }
                                    }
                                }
                                HorizontalLayout {
                                    spacing: 10px; alignment: start;
                                    ShieldBadge {}
                                    VerticalLayout {
                                        spacing: 3px; horizontal-stretch: 1;
                                        Text { text: paste-permission-title; color: #1f2937; font-size: 13px; font-weight: 700; }
                                        Text { text: paste-permission-body;  color: #667085; font-size: 12px; wrap: word-wrap; }
                                    }
                                }
                                VerticalLayout {
                                    spacing: 3px;
                                    Text { text: "默认设备";       color: #9ca3af; font-size: 11px; }
                                    Text { text: default-device-text; color: #1f2937; font-size: 15px; font-weight: 700; }
                                }
                            }
                        }

                        // 语音转写测试
                        Rectangle {
                            border-radius: 18px; background: #ffffff;
                            border-width: 1px; border-color: #d7dee8;

                            VerticalLayout {
                                alignment: start; padding: 18px; spacing: 10px;
                                HorizontalLayout {
                                    spacing: 7px; height: 22px;
                                    SectionIcon { label: "♪"; icon-color: #8b5cf6; }
                                    Text { text: transcribe-card-title; color: #1f2937; font-size: 14px; font-weight: 700; vertical-alignment: center; }
                                    Rectangle { horizontal-stretch: 1; background: transparent; }
                                }
                                HorizontalLayout {
                                    spacing: 14px; alignment: center;
                                    Rectangle {
                                        width: 62px; height: 62px; border-radius: 16px; background: #2962ff;
                                        TouchArea { clicked => { root.toggle-live-asr-requested(); } }
                                        Text { text: "🎤"; horizontal-alignment: center; vertical-alignment: center; font-size: 26px; }
                                    }
                                    VerticalLayout {
                                        alignment: center;
                                        spacing: 4px;
                                        Text { text: transcribe-button-text; color: #1f2937; font-size: 16px; font-weight: 700; }
                                        Text { text: transcribe-body-text;   color: #667085; font-size: 12px; wrap: word-wrap; }
                                    }
                                }
                                VerticalLayout {
                                    spacing: 6px;
                                    HorizontalLayout {
                                        Text { text: "输入音量"; color: #9ca3af; font-size: 12px; horizontal-stretch: 1; }
                                        Text { text: audio-level-text; color: #9ca3af; font-size: 12px; }
                                    }
                                    Rectangle {
                                        height: 6px; border-radius: 3px; background: #e5e7eb;
                                        Rectangle { height: 6px; border-radius: 3px; background: #3b82f6; width: parent.width * root.audio-level-value; }
                                    }
                                }
                                Button { text: monitor-button-text; clicked => { root.toggle-mic-monitor-requested(); } }
                                Rectangle {
                                    border-radius: 10px; background: #fff7e8;
                                    VerticalLayout {
                                        padding: 12px;
                                        Text { text: monitor-tip-text; color: #c26b16; wrap: word-wrap; font-size: 12px; font-weight: 600; }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}
