export component OverlayWindow inherits Window {
    in-out property <string> overlay-state-text: "Idle";
    in-out property <float> overlay-audio-level: 0.0;
    in-out property <string> overlay-live-text: "";

    title: "Shanji Overlay";
    width: 312px;
    no-frame: true;
    always-on-top: true;
    background: transparent;
    default-font-family: "Hiragino Sans GB";

    property <length> bar1-h: max(2px, overlay-audio-level * 0.60 * 14px);
    property <length> bar2-h: max(4px, overlay-audio-level * 1.00 * 14px);
    property <length> bar3-h: max(3px, overlay-audio-level * 0.80 * 14px);
    property <length> bar4-h: max(3px, overlay-audio-level * 0.50 * 14px);
    animate bar1-h { duration: 120ms; easing: ease-out; }
    animate bar2-h { duration: 120ms; easing: ease-out; }
    animate bar3-h { duration: 120ms; easing: ease-out; }
    animate bar4-h { duration: 120ms; easing: ease-out; }

    VerticalLayout {
        alignment: start;
        spacing: 4px;
        padding: 0px;

        // ── Main capsule ──────────────────────────────────────────────────────
        HorizontalLayout {
            alignment: center;

            Rectangle {
                width: 243px;
                height: 34px;
                border-radius: 17px;
                background: #111111;
                clip: true;

                HorizontalLayout {
                    padding-left: 12px;
                    padding-right: 12px;
                    spacing: 0px;
                    alignment: center;

                    Text {
                        text: "语音输入";
                        color: #ffffff;
                        font-size: 11px;
                        font-weight: 700;
                        vertical-alignment: center;
                    }

                    Rectangle { width: 8px; }

                    VerticalLayout {
                        alignment: center;
                        Rectangle {
                            width: 1px;
                            height: 12px;
                            background: #ffffff50;
                        }
                    }

                    Rectangle { width: 8px; }

                    HorizontalLayout {
                        spacing: 2px;
                        alignment: center;

                        VerticalLayout {
                            alignment: center;
                            Rectangle { width: 2px; height: bar1-h; border-radius: 1px; background: #ffffffcc; }
                        }
                        VerticalLayout {
                            alignment: center;
                            Rectangle { width: 2px; height: bar2-h; border-radius: 1px; background: #ffffffcc; }
                        }
                        VerticalLayout {
                            alignment: center;
                            Rectangle { width: 2px; height: bar3-h; border-radius: 1px; background: #ffffffcc; }
                        }
                        VerticalLayout {
                            alignment: center;
                            Rectangle { width: 2px; height: bar4-h; border-radius: 1px; background: #ffffffcc; }
                        }
                    }
                }
            }
        }

        // ── Live text pill — only shown when text is non-empty ────────────────
        if overlay-live-text != "": HorizontalLayout {
            alignment: center;

            Rectangle {
                width: 300px;
                border-radius: 12px;
                background: #000000bb;

                HorizontalLayout {
                    padding-left: 12px;
                    padding-right: 12px;
                    padding-top: 6px;
                    padding-bottom: 6px;

                    Text {
                        text: overlay-live-text;
                        color: #ffffffdd;
                        font-size: 10px;
                        horizontal-alignment: center;
                        wrap: word-wrap;
                    }
                }
            }
        }
    }
}
